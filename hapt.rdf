        <skos:notation>dpv-PrivateSectorEvent</skos:notation>
        <skos:definition xml:lang="en">An event held in the private sector.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-EventManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30, CN31)</skos:note>
