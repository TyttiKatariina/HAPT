<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="https://tyttikatariina.github.io/HAPT/#"
     xml:base="https://tyttikatariina.github.io/HAPT/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:hapt="https://tyttikatariina.github.io/HAPT/#">

    <!-- SKOS classes used in this file, declared so they are recognised as classes -->

    <rdfs:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>

    <skos:ConceptScheme rdf:about="https://tyttikatariina.github.io/HAPT/">
        <skos:prefLabel xml:lang="en">HAPT: High-Risk AI and data Processing Terms</skos:prefLabel>
        <skos:altLabel xml:lang="en">HAPT</skos:altLabel>
        <skos:notation>hapt</skos:notation>
        <skos:definition xml:lang="en">HAPT is a vocabulary of terms used to describe the conditions under which an impact assessment is, or is not, required under the GDPR and the EU AI Act: the domains, purposes, processing contexts, entities, data categories, locations, technologies and consequences that appear in the DPIA Required and DPIA Not Required lists of Member State Data Protection Authorities and in Annex III of the AI Act.</skos:definition>
        <skos:related rdf:resource="https://tyttikatariina.github.io/IMPACTO/"/>
        <dct:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <skos:note xml:lang="en">Licensed under a Creative Commons Attribution 4.0 International License (CC BY 4.0).</skos:note>
        <skos:note xml:lang="en">Draft. The namespace is provisional; definitions noted as drafts have not yet been reviewed.</skos:note>
        <skos:note xml:lang="en">Authors: Tytti Rintamäki (ADAPT Centre, Dublin City University); Harshvardhan J. Pandit (AI Accountability Lab, Trinity College Dublin)</skos:note>
        <skos:note xml:lang="en">Sources: GDPR (Regulation EU 2016/679) Art. 35(4) and 35(5) lists of Member State Data Protection Authorities; EU AI Act (Regulation EU 2024/1689) Annex III</skos:note>
    </skos:ConceptScheme>

    <owl:Ontology rdf:about="https://tyttikatariina.github.io/HAPT/">
        <dct:title>HAPT</dct:title>
        <rdfs:label xml:lang="en">High-Risk AI and data Processing Terms</rdfs:label>
        <dct:creator>Tytti Rintamäki</dct:creator>
        <dct:contributor>Harshvardhan J. Pandit</dct:contributor>
        <dct:publisher>ADAPT Centre, Dublin City University</dct:publisher>
        <dct:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-05</dct:modified>
        <vann:preferredNamespacePrefix>hapt</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://tyttikatariina.github.io/HAPT/#</vann:preferredNamespaceUri>
    </owl:Ontology>

    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Domains
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Biometrics -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Biometrics">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Biometrics</skos:prefLabel>
        <skos:notation>dpv-Biometrics</skos:notation>
        <skos:definition xml:lang="en">Domain concerning the use of biometric technologies, such as remote biometric identification, biometric categorisation and emotion recognition, insofar as their use is permitted under relevant Union or national law.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Sector"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 1 (Recitals 54, 159)</skos:note>
        <skos:note xml:lang="en">Annex III wording: Biometrics</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-EntireSector -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-EntireSector">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Entire Sector</skos:prefLabel>
        <skos:notation>dpv-EntireSector</skos:notation>
        <skos:definition xml:lang="en">The intended use of a technology for an entire sector.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Sector"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: HU (conditions C81)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-EntireSector</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-EssentialPublicAssistanceBenefit -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-EssentialPublicAssistanceBenefit">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Essential Public Assistance Benefit</skos:prefLabel>
        <skos:notation>dpv-EssentialPublicAssistanceBenefit</skos:notation>
        <skos:definition xml:lang="en">A benefit provided by or on behalf of public authorities as essential public assistance to natural persons.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-PublicServicesAndBenefits"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-a"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5(a) (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: essential public assistance benefits</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-EssentialPublicAssistanceService -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-EssentialPublicAssistanceService">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Essential Public Assistance Service</skos:prefLabel>
        <skos:notation>dpv-EssentialPublicAssistanceService</skos:notation>
        <skos:definition xml:lang="en">A service provided by or on behalf of public authorities as essential public assistance to natural persons.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-PublicServicesAndBenefits"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-a"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5(a) (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: essential public assistance services</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-HealthcareService -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-HealthcareService">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Healthcare Service</skos:prefLabel>
        <skos:notation>dpv-HealthcareService</skos:notation>
        <skos:definition xml:lang="en">A healthcare service provided as part of essential public assistance.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-EssentialPublicAssistanceService"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-a"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5(a) (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: healthcare services</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicSector -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicSector">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Sector</skos:prefLabel>
        <skos:notation>dpv-PublicSector</skos:notation>
        <skos:definition xml:lang="en">The sector comprising bodies governed by public law and the persons employed or paid by them.</skos:definition>
        <skos:scopeNote xml:lang="en">The parent concept was not stated in the source analysis; the parent shown here is a suggestion for review.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Sector"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicSector</skos:changeNote>
        <skos:editorialNote xml:lang="en">A concept with the same name already exists in DPV 2.3 (eu-aiact:PublicSector); check whether it can be reused instead.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicServicesAndBenefits -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicServicesAndBenefits">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Services and Benefits</skos:prefLabel>
        <skos:notation>dpv-PublicServicesAndBenefits</skos:notation>
        <skos:definition xml:lang="en">Domain concerning access to and enjoyment of essential private services and essential public services and benefits.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Sector"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5 (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: public services, public benefits</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>
    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Purposes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AccommodationOrganisation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AccommodationOrganisation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Accommodation Organisation</skos:prefLabel>
        <skos:notation>dpv-AccommodationOrganisation</skos:notation>
        <skos:definition xml:lang="en">The organisation of stays and accommodation in connection with an event.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-EventManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30, CN31)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AccommodationOrganisation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Accounting -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Accounting">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Accounting</skos:prefLabel>
        <skos:notation>dpv-Accounting</skos:notation>
        <skos:definition xml:lang="en">Recording, classifying and reporting the financial transactions of an organisation.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN12, CN25, CN32, CN62)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Accounting</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-finance-AccountOperation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-finance-AccountOperation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Account Operation</skos:prefLabel>
        <skos:notation>sector-finance-AccountOperation</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with operating accounts, such as operating and cost accounts.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/finance#AccountManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV finance sector extension (sector-finance)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN25)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-finance-AccountOperation</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AcquisitionCosts -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AcquisitionCosts">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Acquisition Costs</skos:prefLabel>
        <skos:notation>dpv-AcquisitionCosts</skos:notation>
        <skos:definition xml:lang="en">The costs incurred in acquiring goods or assets, recorded as part of inventory management.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataInventoryManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN12)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AcquisitionCosts</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AlternativeDisputeResolution -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AlternativeDisputeResolution">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Alternative Dispute Resolution</skos:prefLabel>
        <skos:notation>dpv-AlternativeDisputeResolution</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with researching and interpreting facts and the law and applying the law to facts in alternative dispute resolution.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DisputeManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/law#JudicialDisputeManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-8-a"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 8(a) (Recital 61)</skos:note>
        <skos:note xml:lang="en">Annex III wording: alternative dispute resolution</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-finance-AncillaryAccounting -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-finance-AncillaryAccounting">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Ancillary Accounting</skos:prefLabel>
        <skos:notation>sector-finance-AncillaryAccounting</skos:notation>
        <skos:definition xml:lang="en">Accounting carried out in support of an organisation's principal accounts.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/finance#FinancialServiceManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV finance sector extension (sector-finance)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN25)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-finance-AncillaryAccounting</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AncillaryRecords -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AncillaryRecords">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Ancillary Records</skos:prefLabel>
        <skos:notation>dpv-AncillaryRecords</skos:notation>
        <skos:definition xml:lang="en">Records kept in support of an organisation's principal accounting records.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-Accounting"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN12)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AncillaryRecords</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Archive -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Archive">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Archive</skos:prefLabel>
        <skos:notation>dpv-Archive</skos:notation>
        <skos:definition xml:lang="en">Processing of personal data for archival purposes in the public interest.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN23)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Archive</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-finance-AuxiliaryAccounting -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-finance-AuxiliaryAccounting">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Auxiliary Accounting</skos:prefLabel>
        <skos:notation>sector-finance-AuxiliaryAccounting</skos:notation>
        <skos:definition xml:lang="en">Supplementary accounting maintained alongside an organisation's principal accounts.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/finance#FinancialServiceManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV finance sector extension (sector-finance)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN25)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-finance-AuxiliaryAccounting</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AuxiliaryRecords -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AuxiliaryRecords">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Auxiliary Records</skos:prefLabel>
        <skos:notation>dpv-AuxiliaryRecords</skos:notation>
        <skos:definition xml:lang="en">Supplementary records maintained alongside an organisation's principal accounting records, such as supplier records related to inventory management.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-Accounting"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN12)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AuxiliaryRecords</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AwardingDecorations -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AwardingDecorations">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Awarding Decorations</skos:prefLabel>
        <skos:notation>dpv-AwardingDecorations</skos:notation>
        <skos:definition xml:lang="en">Processing carried out for the awarding of decorations or similar honours, including the related preliminary examinations.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
