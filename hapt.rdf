    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Locations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#loc-Border -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-Border">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Border</skos:prefLabel>
        <skos:notation>loc-Border</skos:notation>
        <skos:definition xml:lang="en">The place at which border control is carried out on a natural person who intends to enter the territory of a Member State.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Location"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#BorderControlSector"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-MemberStateTerritory"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-b"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 7(b) (Recital 60)</skos:note>
        <skos:note xml:lang="en">Annex III wording: at border management (individual intends to enter)</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CentralisedLocation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CentralisedLocation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Centralised Location</skos:prefLabel>
        <skos:notation>dpv-CentralisedLocation</skos:notation>
        <skos:definition xml:lang="en">A physical or digital point where data is collected and aggregated from multiple sources, typically involving centralised sensors or mobile-based systems for large-scale monitoring or control.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LocationFixture"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: DE, SI (conditions C62)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-CentralisedLocation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ContractuallyAccessiblePlace -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ContractuallyAccessiblePlace">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Contractually Accessible Place</skos:prefLabel>
        <skos:notation>dpv-ContractuallyAccessiblePlace</skos:notation>
        <skos:definition xml:lang="en">A place that may be entered by persons on the basis of a contractual relationship with the person responsible for it.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PubliclyAccessibleSpace"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ContractuallyAccessiblePlace</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-CooperativeSocietyOfApartments -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-CooperativeSocietyOfApartments">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Cooperative Society Of Apartments</skos:prefLabel>
        <skos:notation>loc-CooperativeSocietyOfApartments</skos:notation>
        <skos:definition xml:lang="en">A cooperative society of apartments responsible for the management of multi-apartment residential buildings, related buildings and land.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/loc#Locality"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN55)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-CooperativeSocietyOfApartments</skos:changeNote>
        <skos:editorialNote xml:lang="en">Parent loc:Locality was not found in DPV 2.3.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-EducationalInstitution -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-EducationalInstitution">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Educational Institution</skos:prefLabel>
        <skos:notation>loc-EducationalInstitution</skos:notation>
        <skos:definition xml:lang="en">An educational institution (including but not limited to school, university etc.).</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required; Annex III</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, NL (conditions C57); AI Act Annex III, point 3 (Recital 56)</skos:note>
        <skos:note xml:lang="en">Annex III wording: educational institution of all levels</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-EducationalInstitution</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-Healthcare -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-Healthcare">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Healthcare Location</skos:prefLabel>
        <skos:notation>loc-Healthcare</skos:notation>
        <skos:definition xml:lang="en">A place where healthcare is provided to individuals.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, LT, NL (conditions C57, C114)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-Healthcare</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LimitedPublicArea -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LimitedPublicArea">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Limited Public Area</skos:prefLabel>
        <skos:notation>dpv-LimitedPublicArea</skos:notation>
        <skos:definition xml:lang="en">A public area included within a monitored space only to the limited extent that its inclusion is unavoidable.</skos:definition>
        <skos:scopeNote xml:lang="en">The parent concept was not stated in the source analysis; the parent shown here is a suggestion for review.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/loc#Locality"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN16)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LimitedPublicArea</skos:changeNote>
        <skos:editorialNote xml:lang="en">Parent loc:Locality was not found in DPV 2.3.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-MemberStateTerritory -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-MemberStateTerritory">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Member State Territory</skos:prefLabel>
        <skos:notation>dpv-MemberStateTerritory</skos:notation>
        <skos:definition xml:lang="en">The territory of a single Member State, where processing is carried out exclusively within it.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Locality"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#loc-Border"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN32, CN33, CN34)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-MemberStateTerritory</skos:changeNote>
        <skos:editorialNote xml:lang="en">Parent dpv:Locality was not found in DPV 2.3.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-MultiOccupancyProperty -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-MultiOccupancyProperty">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Multi Occupancy Property</skos:prefLabel>
        <skos:notation>dpv-MultiOccupancyProperty</skos:notation>
        <skos:definition xml:lang="en">A property occupied by multiple owners or households, managed by an owners' association or sub-association.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/loc#Locality"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN63, CN64)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-MultiOccupancyProperty</skos:changeNote>
        <skos:editorialNote xml:lang="en">Parent loc:Locality was not found in DPV 2.3.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-MultiOccupancyProperty; the previous index named this term loc-MultiOccupancyProperty. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PotentiallyHazardousLocation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PotentiallyHazardousLocation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Potentially Hazardous Location</skos:prefLabel>
        <skos:notation>dpv-PotentiallyHazardousLocation</skos:notation>
        <skos:definition xml:lang="en">A location that, by its nature, carries a special potential hazard to persons or things.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Location"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PotentiallyHazardousLocation</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-PreSchool -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-PreSchool">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Pre School</skos:prefLabel>
        <skos:notation>loc-PreSchool</skos:notation>
        <skos:definition xml:lang="en">A school or other establishment that provides early childhood education before compulsory schooling.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#loc-EducationalInstitution"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IS, NO (conditions C50)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-PreSchool</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-Prison -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-Prison">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Prison</skos:prefLabel>
        <skos:notation>loc-Prison</skos:notation>
        <skos:definition xml:lang="en">A place in which individuals are held due to committing a crime or awaiting trial.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, NL (conditions C57)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-Prison</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicInterestAccessiblePlace -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicInterestAccessiblePlace">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Interest Accessible Place</skos:prefLabel>
        <skos:notation>dpv-PublicInterestAccessiblePlace</skos:notation>
        <skos:definition xml:lang="en">A place that may be entered by persons because of a public interest.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PubliclyAccessibleSpace"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicInterestAccessiblePlace</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicRoad -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicRoad">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Road</skos:prefLabel>
        <skos:notation>dpv-PublicRoad</skos:notation>
        <skos:definition xml:lang="en">Any location accessible to the general public, particularly roads and streets used by public or private transportation, where monitoring or control of individuals is conducted via processing operations such as video surveillance or traffic sensors.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PubliclyAccessibleSpace"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT, CY, FR, PL, SI (conditions C43, C49)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-OnPublicRoad</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-PublicRoad; the previous index named this term loc-OnPublicRoad. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicTransport -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicTransport">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Transport</skos:prefLabel>
        <skos:notation>dpv-PublicTransport</skos:notation>
        <skos:definition xml:lang="en">Vehicles and infrastructures used for public travel, such as buses, trains, metro, and stations, where individuals are subject to monitoring or data processing.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PubliclyAccessibleSpace"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT, CY, FR, PL (conditions C43)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-InPublicTransport</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-PublicTransport; the previous index named this term loc-InPublicTransport. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-School -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-School">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">School</skos:prefLabel>
        <skos:notation>loc-School</skos:notation>
        <skos:definition xml:lang="en">A school as a location in which processing or monitoring takes place.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#loc-EducationalInstitution"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IS, LV, NL, NO (conditions C50, C57, C70)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-School</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV 2.3 has pd:School, which is a personal data category (the school attended), not a location.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-SocialCare -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-SocialCare">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Socialcare Location</skos:prefLabel>
        <skos:notation>loc-SocialCare</skos:notation>
        <skos:definition xml:lang="en">A place where social care is provided to individuals.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, NL (conditions C57)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-SocialCare</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Workplace -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Workplace">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Workplace</skos:prefLabel>
        <skos:notation>dpv-Workplace</skos:notation>
        <skos:definition xml:lang="en">A professional environment or workplace.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
        <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/HAPT/#loc-Workplace"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Workplace</skos:changeNote>
        <skos:editorialNote xml:lang="en">Same concept as hapt:loc-Workplace, written differently in the condition files. Kept as a separate term so that every concept in the condition files resolves; consider using one spelling in the condition files.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-Workplace -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-Workplace">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Workplace</skos:prefLabel>
        <skos:notation>loc-Workplace</skos:notation>
        <skos:definition xml:lang="en">A professional environment or workplace.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, NL (conditions C57)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-Workplace</skos:changeNote>
        <skos:editorialNote xml:lang="en">The condition files also use the variant hapt:dpv-Workplace for this concept; it is listed separately as an exact match so that it resolves.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#loc-WorshipLocation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#loc-WorshipLocation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Worship Location</skos:prefLabel>
        <skos:notation>loc-WorshipLocation</skos:notation>
        <skos:definition xml:lang="en">A religious institution such as a church or house of prayer, where monitoring or data processing may occur for security or organisational purposes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Location"/>
        <skos:note xml:lang="en">Proposed for: DPV location extension (loc)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT (conditions C68)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#loc-WorshipLocation</skos:changeNote>
    </skos:Concept>
    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Technologies and Capabilities
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#tech-AcousticRecording -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-AcousticRecording">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Acoustic Recording</skos:prefLabel>
        <skos:notation>tech-AcousticRecording</skos:notation>
        <skos:definition xml:lang="en">Technology for recording sound, such as audio recording at events.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-AcousticRecording</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-AutomatedAccess -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-AutomatedAccess">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Automated System</skos:prefLabel>
        <skos:notation>tech-AutomatedAccess</skos:notation>
        <skos:definition xml:lang="en">A system that processes personal data with automated assistance, such as a system controlling authorisation of access to buildings and delimited areas.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/tech#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN15)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-AutomatedAccess</skos:changeNote>
        <skos:editorialNote xml:lang="en">Parent tech:Technology was not found in DPV 2.3.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-AutomatedAssistance -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-AutomatedAssistance">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Automated Assistance</skos:prefLabel>
        <skos:notation>tech-AutomatedAssistance</skos:notation>
        <skos:definition xml:lang="en">Technology that assists a human in carrying out a task in an automated way, such as systems controlling access to buildings.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN15)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-AutomatedAssistance</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#ai-AutomaticObjectRecognition -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#ai-AutomaticObjectRecognition">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Automatic Object Recognition</skos:prefLabel>
        <skos:notation>ai-AutomaticObjectRecognition</skos:notation>
        <skos:definition xml:lang="en">The use of an AI system capable of automatic object recognition.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/ai#Capability"/>
        <skos:note xml:lang="en">Proposed for: DPV AI extension (ai)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CY, PL, SI (conditions C49)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#ai-AutomaticObjectRecognition</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-BiometricDevice -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-BiometricDevice">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Biometric Device</skos:prefLabel>
        <skos:notation>tech-BiometricDevice</skos:notation>
        <skos:definition xml:lang="en">A device that captures or processes biometric data, such as a fingerprint or facial recognition reader.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/tech#Device"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN49)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-BiometricDevice</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CameraSurveillance -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CameraSurveillance">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Camera Surveillance</skos:prefLabel>
        <skos:notation>dpv-CameraSurveillance</skos:notation>
        <skos:definition xml:lang="en">The use of video and/or audio data to surveil an area.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#TechnicalOrganisationalMeasure"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LT, NL, NO (conditions C69, C70, C114)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-CameraSurveillance</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-CCTV -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-CCTV">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">CCTV</skos:prefLabel>
        <skos:notation>tech-CCTV</skos:notation>
        <skos:definition xml:lang="en">Closed-circuit television, meaning a system of video cameras transmitting images to a limited set of monitors or recorders.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/tech#Device"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CY (conditions C111)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-CCTV</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Overlaps with hapt:dpv-CameraSurveillance.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-health-ElectronicPresecriptionSystem -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-health-ElectronicPresecriptionSystem">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Electronic Prescription System</skos:prefLabel>
        <skos:notation>sector-health-ElectronicPresecriptionSystem</skos:notation>
        <skos:definition xml:lang="en">A system used by healthcare providers to create, transmit, and manage electronic prescriptions as part of large-scale systematic health data processing.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/health#System"/>
        <skos:note xml:lang="en">Proposed for: DPV health sector extension (sector-health)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: FR, GR, HU, NL (conditions C39)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-health-ElectronicPrescriptionSystem</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use sector-health-ElectronicPresecriptionSystem; the previous index named this term sector-health-ElectronicPrescriptionSystem. The condition-file spelling is used for the IRI.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The condition-file spelling contains a typo (Presecription); consider correcting it in the condition files and here to ElectronicPrescriptionSystem.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#ai-FacialRecognition -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#ai-FacialRecognition">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Facial Recognition</skos:prefLabel>
        <skos:notation>ai-FacialRecognition</skos:notation>
        <skos:definition xml:lang="en">The use of an AI system capable of facial recognition.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/ai#Capability"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#BiometricIdentification"/>
        <skos:note xml:lang="en">Proposed for: DPV AI extension (ai)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CY, DK, IT, PL, RO (conditions C36)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#ai-FacialRecognition</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FacialRecognitionTechnology -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FacialRecognitionTechnology">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Facial Recognition Technology</skos:prefLabel>
        <skos:notation>eu-aiact-FacialRecognitionTechnology</skos:notation>
        <skos:definition xml:lang="en">A biometric identification system that detects, captures, and compares facial features to identify or verify individuals in real-time or retrospectively, as defined in the EU AI Act.</skos:definition>
        <skos:scopeNote xml:lang="en">Proposed as rename/replacement of current tech:FaceRecognition to align with EU AI Act terminology.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/tech#Capability"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#BiometricIdentification"/>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CY, DK, IT, PL, RO</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FacialRecognitionTechnology</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-ImageRecording -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-ImageRecording">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Image Recording</skos:prefLabel>
        <skos:notation>tech-ImageRecording</skos:notation>
        <skos:definition xml:lang="en">Technology for recording still or moving images, such as photographs or video at events.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-ImageRecording</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-ImplantableMedicalDevice -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-ImplantableMedicalDevice">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Implantable Medical Device</skos:prefLabel>
        <skos:notation>tech-ImplantableMedicalDevice</skos:notation>
        <skos:definition xml:lang="en">A device that is implanted into an individual for medical purposes and generates health data about said individual.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, CY, IS, PT (conditions C42)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-ImplantableMedicalDevice</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-LifeLoggingApplication -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-LifeLoggingApplication">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Life Logging Application</skos:prefLabel>
        <skos:notation>tech-LifeLoggingApplication</skos:notation>
        <skos:definition xml:lang="en">An application that offers its users the possibility of recording and keeping a log of their daily activities.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/tech#Application"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CY (conditions C112)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-LifeLoggingApplication</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#ai-NaturalPersonDetection -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#ai-NaturalPersonDetection">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Natural Person Detection</skos:prefLabel>
        <skos:notation>ai-NaturalPersonDetection</skos:notation>
        <skos:definition xml:lang="en">Capability of detecting natural persons in the context of migration, asylum or border control management.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/ai#HumanOrientedCapability"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-d"/>
        <skos:note xml:lang="en">Proposed for: DPV AI extension (ai)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 7(d) (Recital 60)</skos:note>
        <skos:note xml:lang="en">Annex III wording: detecting natural person</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#ai-NaturalPersonRecognition -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#ai-NaturalPersonRecognition">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Natural Person Recognition</skos:prefLabel>
        <skos:notation>ai-NaturalPersonRecognition</skos:notation>
        <skos:definition xml:lang="en">Capability of recognising natural persons in the context of migration, asylum or border control management.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/ai#HumanOrientedCapability"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#HumanIdentification"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-d"/>
        <skos:note xml:lang="en">Proposed for: DPV AI extension (ai)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 7(d) (Recital 60)</skos:note>
        <skos:note xml:lang="en">Annex III wording: recognising natural person</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-Neurotechnology -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-Neurotechnology">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Neurotechnology</skos:prefLabel>
        <skos:notation>tech-Neurotechnology</skos:notation>
        <skos:definition xml:lang="en">A technology that processes neural or brain-derived data, enabling applications in healthcare, human enhancement, or cognitive monitoring.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: DK (conditions C85)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-Neurotechnology</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#ai-ObjectIsolation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#ai-ObjectIsolation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Object Isolation</skos:prefLabel>
        <skos:notation>ai-ObjectIsolation</skos:notation>
        <skos:definition xml:lang="en">The use of an AI system capable of isolating objects.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/ai#Capability"/>
        <skos:note xml:lang="en">Proposed for: DPV AI extension (ai)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CY, PL, SI (conditions C49)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#ai-ObjectIsolation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Polygraph -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Polygraph">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Polygraph</skos:prefLabel>
        <skos:notation>dpv-Polygraph</skos:notation>
        <skos:definition xml:lang="en">A polygraph or similar tool used by or on behalf of competent public authorities, including law enforcement authorities.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#LieDetection"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-6-b"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-a"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 6(b), 7(a) (Recital 60; Recitals 59, 159)</skos:note>
        <skos:note xml:lang="en">Annex III wording: polygraph, similar tools</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-Sensor -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-Sensor">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Sensor</skos:prefLabel>
        <skos:notation>tech-Sensor</skos:notation>
        <skos:definition xml:lang="en">Innovative device or technology used for detecting, collecting, or transmitting data, often as part of mobile or centralised systems, enabling real-time monitoring or measurement of physical conditions, behaviours, or environments.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/tech#Component"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: DE, SI (conditions C62)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-Sensor</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-SmartMeter -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-SmartMeter">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Smart Meter</skos:prefLabel>
        <skos:notation>tech-SmartMeter</skos:notation>
        <skos:definition xml:lang="en">A device installed by utility providers that automatically tracks and transmits consumption data, such as electricity, gas, or water usage.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/tech#Device"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, GR, HU, NL, PL, RO (conditions C23)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-SmartMeter</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-Tool -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-Tool">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Tool</skos:prefLabel>
        <skos:notation>tech-Tool</skos:notation>
        <skos:definition xml:lang="en">An application, tool or platform that is set up for use by the controller or by an entire sector.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: HU (conditions C81)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-Tool</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>
    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Consequences and Impacts
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ContractExclusion -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ContractExclusion">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Contract Exclusion</skos:prefLabel>
        <skos:notation>dpv-ContractExclusion</skos:notation>
        <skos:definition xml:lang="en">Where an individual or an organisation is denied the opportunity to enter into a contract.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ImpactOnContract"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, CY, FR, GR, IS, IT, LI, SI, ES, SE (conditions C20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ContractExclusion</skos:changeNote>
        <skos:editorialNote xml:lang="en">Renamed from risk-ContractExclusion to dpv-ContractExclusion following the concept register (9 November 2026).</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-ContractRefused -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-ContractRefused">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Contract Refused</skos:prefLabel>
        <skos:notation>risk-ContractRefused</skos:notation>
        <skos:definition xml:lang="en">An impact where personal data, often from third parties, is used to inform a decision to deny entry into a service contract with a natural person.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ImpactOnContract"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ContractRefused</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ContractSuspension -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ContractSuspension">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Contract Suspension</skos:prefLabel>
        <skos:notation>dpv-ContractSuspension</skos:notation>
        <skos:definition xml:lang="en">Where an existing contract is temporarily halted or rendered inactive, such as due to suspicion of fraud, violation of terms, or negative behavioural indicators.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ImpactOnContract"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, CY, FR, GR, IS, IT, LI, SI, ES, SE (conditions C20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ContractSuspension</skos:changeNote>
        <skos:editorialNote xml:lang="en">Renamed from risk-ContractSuspension to dpv-ContractSuspension following the concept register (9 November 2026).</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-ImpactOnCareer -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-ImpactOnCareer">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Impact On Career</skos:prefLabel>
        <skos:notation>risk-ImpactOnCareer</skos:notation>
        <skos:definition xml:lang="en">Where the career of an individual is impacted.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Impact"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: EE</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ImpactOnCareer</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-ImpactOnContract -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-ImpactOnContract">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Impact On Contract</skos:prefLabel>
        <skos:notation>risk-ImpactOnContract</skos:notation>
        <skos:definition xml:lang="en">Where there is an effect, positive or negative, on an existing contract, such as suspension, termination, or exclusion.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Impact"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required; Annex III</skos:note>
        <skos:note xml:lang="en">Source: No source recorded for this concept; the source conditions shown are those of its narrower concepts: dpv-ContractExclusion, risk-ContractRefused, dpv-ContractSuspension, dpv:ContractTerminated, risk-WorkRelationshipTermsAffected.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ImpactOnContract</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-InsufficientProtection -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-InsufficientProtection">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Insufficient Protection</skos:prefLabel>
        <skos:notation>risk-InsufficientProtection</skos:notation>
        <skos:definition xml:lang="en">The risk of insufficient protections put in place to protect for exampel security, accuracy, resilience etc.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/risk#QualityInsufficient"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IE (conditions C80)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-InsufficientProtection</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LegalEffect -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LegalEffect">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Legal Effect Risk</skos:prefLabel>
        <skos:notation>dpv-LegalEffect</skos:notation>
        <skos:definition xml:lang="en">A risk that processing results in legal effects for the data subjects.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Risk"/>
        <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-LegalEffects"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, GR, IS, IT, LV, LI, NO, PL, SI, ES, SE (conditions C17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LegalEffect</skos:changeNote>
        <skos:editorialNote xml:lang="en">Same concept as hapt:risk-LegalEffects, written differently in the condition files. Kept as a separate term so that every concept in the condition files resolves; consider using one spelling in the condition files.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-LegalEffects -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-LegalEffects">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Legal Effects</skos:prefLabel>
        <skos:notation>risk-LegalEffects</skos:notation>
        <skos:definition xml:lang="en">A risk that processing results in legal effects for the data subjects.</skos:definition>
        <skos:scopeNote xml:lang="en">Used to indicate that a processing activity may result in effects equivalent to legal consequences for data subjects, such as denial of service or exclusion from contracts.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Risk"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: DPIA Required lists of all Member States (conditions C6, C8, C99, C105)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-LegalEffect</skos:changeNote>
        <skos:editorialNote xml:lang="en">The condition files also use the variant hapt:dpv-LegalEffect for this concept; it is listed separately as an exact match so that it resolves.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Renamed from risk-LegalEffect to risk-LegalEffects following the concept register (9 November 2026).</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-LimitRights -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-LimitRights">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Limit Rights</skos:prefLabel>
        <skos:notation>risk-LimitRights</skos:notation>
        <skos:definition xml:lang="en">The risk of an individuals rights being limited and therefore negatively impacted.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/risk#RightsImpact"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CZ, SI (conditions C60)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-LimitRights</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-PropertyLoss -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-PropertyLoss">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Property Loss</skos:prefLabel>
        <skos:notation>risk-PropertyLoss</skos:notation>
        <skos:definition xml:lang="en">Loss of property.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/risk#FinancialLoss"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: EE (conditions C101)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-PropertyLoss</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-PublicAssistanceGranted -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-PublicAssistanceGranted">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Assistance Granted</skos:prefLabel>
        <skos:notation>risk-PublicAssistanceGranted</skos:notation>
        <skos:definition xml:lang="en">Where essential public assistance benefits or services are granted to a natural person.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ServiceAccessAllowed"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-a"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5(a) (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: grant public assistance benefits, grant public assistance services</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-PublicAssistanceReduced -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-PublicAssistanceReduced">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Assistance Reduced</skos:prefLabel>
        <skos:notation>risk-PublicAssistanceReduced</skos:notation>
        <skos:definition xml:lang="en">Where essential public assistance benefits or services provided to a natural person are reduced.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ServiceRelatedConsequence"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-a"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5(a) (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: reduced public assistance benefits, reduced public assistance services</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-ServiceAccessAllowed -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-ServiceAccessAllowed">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Service Access Allowed</skos:prefLabel>
        <skos:notation>risk-ServiceAccessAllowed</skos:notation>
        <skos:definition xml:lang="en">Where an individual or an organisation is permitted to use or access a service.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ServiceRelatedConsequence"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, GR, IS, IT, LV, LI, NO, PL, SI, ES, SE</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ServiceAccessAllowed</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-ServiceAccessDenied -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-ServiceAccessDenied">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Service Access Denied</skos:prefLabel>
        <skos:notation>risk-ServiceAccessDenied</skos:notation>
        <skos:definition xml:lang="en">Where an individual or an organisation is prevented from accessing a particular service.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ServiceRelatedConsequence"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, GR, IS, IT, LV, LI, NO, PL, SI, ES, SE (conditions C17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ServiceAccessDenied</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-ServiceExclusion -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-ServiceExclusion">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Service Exclusion</skos:prefLabel>
        <skos:notation>risk-ServiceExclusion</skos:notation>
        <skos:definition xml:lang="en">Consequence where an individual is excluded from, or denied access to, a service as a result of the processing.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ServiceRelatedConsequence"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, GR, IS, IT, LV, LI, NO, PL, SI, ES, SE (conditions C17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-ServiceExclusion</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Overlaps with hapt:risk-ServiceAccessDenied; check whether the two should be merged.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-ServiceRelatedConsequence -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-ServiceRelatedConsequence">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Service Related Consequence</skos:prefLabel>
        <skos:notation>risk-ServiceRelatedConsequence</skos:notation>
        <skos:definition xml:lang="en">A consequence that affects an individual's or organisation's access to or participation in a service.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Impact"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required; Annex III</skos:note>
        <skos:note xml:lang="en">Source: No source recorded for this concept; the source conditions shown are those of its narrower concepts: risk-PublicAssistanceReduced, risk-ServiceAccessAllowed, risk-ServiceAccessDenied.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#ServiceRelatedConsequence</skos:changeNote>
        <skos:editorialNote xml:lang="en">A concept with the same name already exists in DPV 2.3 (risk:ServiceRelatedConsequence); check whether it can be reused instead.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The previous local name ServiceRelatedConsequence did not follow the module-prefix convention and has been normalised to risk-ServiceRelatedConsequence.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-gdpr-SignificantEffect -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-gdpr-SignificantEffect">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Significant Effect</skos:prefLabel>
        <skos:notation>eu-gdpr-SignificantEffect</skos:notation>
        <skos:definition xml:lang="en">An impact that is distinguished as being significant due to having a legal impact.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Impact"/>
        <skos:note xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:note>
        <skos:note xml:lang="en">Source condition: Not recorded</skos:note>
        <skos:note xml:lang="en">Source: Source not recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-SignificantEffect</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-UnauthorisedReversal -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-UnauthorisedReversal">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Unauthorised Reversal</skos:prefLabel>
        <skos:notation>risk-UnauthorisedReversal</skos:notation>
        <skos:definition xml:lang="en">The unauthorised reversal of data e.g. unauthorised reversal of pseudonymised data.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/risk#UnauthorisedActivity"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IE (conditions C80)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#risk-UnauthorisedReversal</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-VotingOutcomeInfluenced -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-VotingOutcomeInfluenced">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Voting Outcome Influenced</skos:prefLabel>
        <skos:notation>risk-VotingOutcomeInfluenced</skos:notation>
        <skos:definition xml:lang="en">Where the outcome of an election or referendum, or the voting behaviour of natural persons, is influenced.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Impact"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-8-b"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 8(b) (Recital 61)</skos:note>
        <skos:note xml:lang="en">Annex III wording: influence voting outcomes in elections, influence voting outcomes in referendums</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-WorkRelationshipPromotion -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-WorkRelationshipPromotion">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Work Relationship Promotion</skos:prefLabel>
        <skos:notation>risk-WorkRelationshipPromotion</skos:notation>
        <skos:definition xml:lang="en">Where a decision results in the promotion of a person in a work-related contractual relationship.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ImpactOnCareer"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-4-b"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 4(b) (Recital 57)</skos:note>
        <skos:note xml:lang="en">Annex III wording: promote work related contractual relationships</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-WorkRelationshipTermination -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-WorkRelationshipTermination">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Work Relationship Termination</skos:prefLabel>
        <skos:notation>risk-WorkRelationshipTermination</skos:notation>
        <skos:definition xml:lang="en">Where a decision results in the termination of a work-related contractual relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ContractTerminated"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-4-b"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 4(b) (Recital 57)</skos:note>
        <skos:note xml:lang="en">Annex III wording: terminate work related contractual relationships</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#risk-WorkRelationshipTermsAffected -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#risk-WorkRelationshipTermsAffected">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Work Relationship Terms Affected</skos:prefLabel>
        <skos:notation>risk-WorkRelationshipTermsAffected</skos:notation>
        <skos:definition xml:lang="en">Where a decision affects the terms of a work-related relationship.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#risk-ImpactOnContract"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-4-b"/>
        <skos:note xml:lang="en">Proposed for: DPV risk extension (risk)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 4(b) (Recital 57)</skos:note>
        <skos:note xml:lang="en">Annex III wording: affecting terms of work related relationships</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>
    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Legal Grounds, Measures and Assessment Terms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AccessLogins -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AccessLogins">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Access Logins</skos:prefLabel>
        <skos:notation>dpv-AccessLogins</skos:notation>
        <skos:definition xml:lang="en">Records of system access events associated with the management of usernames and passwords.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#TechnicalMeasure"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN14)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AccessLogins</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AdministrativeLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AdministrativeLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Administrative Law</skos:prefLabel>
        <skos:notation>dpv-AdministrativeLaw</skos:notation>
        <skos:definition xml:lang="en">The body of law governing the activities of public administration and the relationship between public authorities and natural or legal persons.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Law"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AdministrativeLaw</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-AIProcess -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-AIProcess">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">AI Process</skos:prefLabel>
        <skos:notation>eu-aiact-AIProcess</skos:notation>
        <skos:definition xml:lang="en">A concept extending dpv:Process that represents the deployer's processes in which the AI system is used, as required to be described under AI Act Article 27-1a. Associated using dpv:hasProcess.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Process"/>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: AI Act Article 27-1a</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-AIProcess</skos:changeNote>
        <skos:editorialNote xml:lang="en">A concept with the same name already exists in DPV 2.3 (ai:AIProcess); check whether it can be reused instead.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-AIProcess did not follow the module-prefix convention and has been normalised to eu-aiact-AIProcess.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AuthorisedProcessing -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AuthorisedProcessing">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Authorised Processing</skos:prefLabel>
        <skos:notation>dpv-AuthorisedProcessing</skos:notation>
        <skos:definition xml:lang="en">Processing carried out strictly under guidelines previously established or authorised by a supervisory body, by way of circulars or decisions, and unchanged since that authorisation.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#AuditStatus"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN58, CN59)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AuthorisedProcessing</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-law-CivilLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-law-CivilLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Civil Law</skos:prefLabel>
        <skos:notation>sector-law-CivilLaw</skos:notation>
        <skos:definition xml:lang="en">The body of law governing private relationships between natural and legal persons.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Law"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-law-CivilLaw</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#justifications-CollectiveLegalNorm -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#justifications-CollectiveLegalNorm">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Collective Legal Norm</skos:prefLabel>
        <skos:notation>justifications-CollectiveLegalNorm</skos:notation>
        <skos:definition xml:lang="en">A norm of collective legal design, such as a collective agreement or works agreement, on the basis of which processing is carried out.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Justification"/>
        <skos:note xml:lang="en">Proposed for: DPV justifications extension (justifications)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN6)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#justifications-CollectiveLegalNorm</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ContractualObligation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ContractualObligation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Contractual Obligation</skos:prefLabel>
        <skos:notation>dpv-ContractualObligation</skos:notation>
        <skos:definition xml:lang="en">An obligation arising from a contract, such as an obligation that gives anyone the right to enter a location.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ContractualTerms"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT (conditions C64)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ContractualObligation</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-law-CriminalLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-law-CriminalLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Criminal Law</skos:prefLabel>
        <skos:notation>sector-law-CriminalLaw</skos:notation>
        <skos:definition xml:lang="en">The body of law concerning criminal offences and their punishment.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Law"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-law-CriminalLaw</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DataProtectionAuthorityGuidance -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DataProtectionAuthorityGuidance">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Data Protection Authority Guidance</skos:prefLabel>
        <skos:notation>dpv-DataProtectionAuthorityGuidance</skos:notation>
        <skos:definition xml:lang="en">Guidance, lists or opinions issued by a Data Protection Authority which inform how an obligation is to be interpreted or discharged.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataProtectionAuthority"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN4)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DataProtectionAuthorityGuidance</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DPIAComplete -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DPIAComplete">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">DPIA Complete</skos:prefLabel>
        <skos:notation>dpv-DPIAComplete</skos:notation>
        <skos:definition xml:lang="en">Status indicating that a full data protection impact assessment has already been carried out, for example as part of establishing the legal basis for the processing.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#AuditStatus"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN60)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DPIAComplete</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Check against the IMPACTO status concepts (e.g. impacto:eu-gdpr-DPIAReviewComplete) before publication. Written as Impacto:dpv-DPIAComplete (capital I) in CN60.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DPIAMeasures -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DPIAMeasures">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">DPIA Measures</skos:prefLabel>
        <skos:notation>dpv-DPIAMeasures</skos:notation>
        <skos:definition xml:lang="en">Measures defined within a DPIA which must be implemented for the associated processing to proceed.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalMeasure"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN60)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DPIAMeasures</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#DPIANotRequiredList -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#DPIANotRequiredList">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">DPIA Not Required List</skos:prefLabel>
        <skos:notation>DPIANotRequiredList</skos:notation>
        <skos:definition xml:lang="en">A list of the kinds of processing operations for which no data protection impact assessment is required, established and made public by a supervisory authority under GDPR Art. 35(5), or the corresponding exemptions arising from the GDPR itself and EDPB guidance.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Guideline"/>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Type of the Art. 35(5) lists declared in DPIANotRequiredConditions-2.ttl: at:DPIANotRequiredList, cz:DPIANotRequiredList, es:DPIANotRequiredList, eu-gdpr:DPIANotRequiredList, fr:DPIANotRequiredList, hr:DPIANotRequiredList, it:DPIANotRequiredList, lv:DPIANotRequiredList, nl:DPIANotRequiredList</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#DPIANotRequiredList</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DPIASafeguards -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DPIASafeguards">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">DPIA Safeguards</skos:prefLabel>
        <skos:notation>dpv-DPIASafeguards</skos:notation>
        <skos:definition xml:lang="en">Safeguards defined within a DPIA which must be implemented for the associated processing to proceed.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#OrganisationalMeasure"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN60)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DPIASafeguards</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ExistingDPIAReuse -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ExistingDPIAReuse">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Existing DPIA Reuse</skos:prefLabel>
        <skos:notation>dpv-ExistingDPIAReuse</skos:notation>
        <skos:definition xml:lang="en">The reliance on an existing DPIA for a processing activity whose nature, scope, context and purposes are very similar to those of the processing for which the DPIA was originally carried out.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DPIA"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN2, CN61)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ExistingDPIAReuse</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-FederalLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-FederalLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Federal Law</skos:prefLabel>
        <skos:notation>dpv-FederalLaw</skos:notation>
        <skos:definition xml:lang="en">Law enacted at the federal level of a federal state.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Law"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-FederalLaw</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIACompletedQuestionnaire -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIACompletedQuestionnaire">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Completed Questionnaire</skos:prefLabel>
        <skos:notation>eu-aiact-FRIACompletedQuestionnaire</skos:notation>
        <skos:definition xml:lang="en">A concept extending fria:FRIAQuestionnaire that represents the filled-out questionnaire produced by a deployer, which may be submitted as part of their notice to the market surveillance authority.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAQuestionnaire"/>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: FRIA process under AI Act Art. 27; no specific provision was recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#aiact-FRIACompletedQuestionnaire</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name aiact-FRIACompletedQuestionnaire did not follow the module-prefix convention and has been normalised to eu-aiact-FRIACompletedQuestionnaire.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIANotice -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIANotice">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Notice</skos:prefLabel>
        <skos:notation>eu-aiact-FRIANotice</skos:notation>
        <skos:definition xml:lang="en">A concept extending dpv:Notice that represents the communication artefact through which FRIA results and relevant information are conveyed to a market surveillance authority. Associated using dpv:hasNotice.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Notice"/>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: FRIA process under AI Act Art. 27; no specific provision was recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIANotice</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIANotice did not follow the module-prefix convention and has been normalised to eu-aiact-FRIANotice.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIANotificationAssessment -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIANotificationAssessment">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Notification Assessment</skos:prefLabel>
        <skos:notation>eu-aiact-FRIANotificationAssessment</skos:notation>
        <skos:definition xml:lang="en">A process extending eu-aiact:FRIA that represents the step of determining whether the results of a completed FRIA must be notified to the market surveillance authority, or whether an exemption applies, as per AI Act Article 27-3. Associated with a FRIA using dpv:hasAssessment.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/legal/eu/aiact#FRIA"/>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: AI Act Article 27-3</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIANotificationAssessment</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIANotificationAssessment did not follow the module-prefix convention and has been normalised to eu-aiact-FRIANotificationAssessment.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIANotificationExempt -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIANotificationExempt">
        <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANotificationStatus"/>
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Notification Exempt</skos:prefLabel>
        <skos:notation>eu-aiact-FRIANotificationExempt</skos:notation>
        <skos:definition xml:lang="en">An instance of fria:FRIANotificationStatus indicating that the obligation to notify is exempt as per AI Act Article 46-1. Intended to be expandable per jurisdiction within DPV's modular legal framework.</skos:definition>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: AI Act Article 46-1</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIANotificationExempt</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIANotificationExempt did not follow the module-prefix convention and has been normalised to eu-aiact-FRIANotificationExempt.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeHighResidualRisk -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeHighResidualRisk">
        <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIAOutcomeStatus"/>
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Outcome High Residual Risk</skos:prefLabel>
        <skos:notation>eu-aiact-FRIAOutcomeHighResidualRisk</skos:notation>
        <skos:definition xml:lang="en">An instance of fria:FRIAOutcomeStatus indicating that the FRIA has identified a high residual risk to fundamental rights that is not acceptable for continuation of the AI system's use.</skos:definition>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: FRIA process under AI Act Art. 27; no specific provision was recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIAOutcomeHighResidualRisk</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIAOutcomeHighResidualRisk did not follow the module-prefix convention and has been normalised to eu-aiact-FRIAOutcomeHighResidualRisk.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeRisksAcceptable -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeRisksAcceptable">
        <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIAOutcomeStatus"/>
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Outcome Risks Acceptable</skos:prefLabel>
        <skos:notation>eu-aiact-FRIAOutcomeRisksAcceptable</skos:notation>
        <skos:definition xml:lang="en">An instance of fria:FRIAOutcomeStatus indicating that the FRIA has found residual risks to fundamental rights remain but are at a level acceptable for continuation.</skos:definition>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: FRIA process under AI Act Art. 27; no specific provision was recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIAOutcomeRisksAcceptable</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIAOutcomeRisksAcceptable did not follow the module-prefix convention and has been normalised to eu-aiact-FRIAOutcomeRisksAcceptable.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeRisksMitigated -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeRisksMitigated">
        <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIAOutcomeStatus"/>
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Outcome Risks Mitigated</skos:prefLabel>
        <skos:notation>eu-aiact-FRIAOutcomeRisksMitigated</skos:notation>
        <skos:definition xml:lang="en">An instance of fria:FRIAOutcomeStatus indicating that the FRIA has found all risks to fundamental rights have been mitigated and the AI system is safe for continuation.</skos:definition>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: FRIA process under AI Act Art. 27; no specific provision was recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIAOutcomeRisksMitigated</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIAOutcomeRisksMitigated did not follow the module-prefix convention and has been normalised to eu-aiact-FRIAOutcomeRisksMitigated.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeUnacceptableRisk -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAOutcomeUnacceptableRisk">
        <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIAOutcomeStatus"/>
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Outcome Unacceptable Risk</skos:prefLabel>
        <skos:notation>eu-aiact-FRIAOutcomeUnacceptableRisk</skos:notation>
        <skos:definition xml:lang="en">An instance of fria:FRIAOutcomeStatus indicating that the FRIA has identified an unacceptable risk to fundamental rights, implying the AI system should not be used.</skos:definition>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: FRIA process under AI Act Art. 27; no specific provision was recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIAOutcomeUnacceptableRisk</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIAOutcomeUnacceptableRisk did not follow the module-prefix convention and has been normalised to eu-aiact-FRIAOutcomeUnacceptableRisk.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAQuestionnaire -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIAQuestionnaire">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Questionnaire</skos:prefLabel>
        <skos:notation>eu-aiact-FRIAQuestionnaire</skos:notation>
        <skos:definition xml:lang="en">A concept representing the template questionnaire provided to deployers for the purpose of fulfilling FRIA obligations, as referenced in AI Act Article 27-5. Used as the basis from which a deployer produces a completed questionnaire.</skos:definition>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: AI Act Article 27-5</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#fria-FRIAQuestionnaire</skos:changeNote>
        <skos:editorialNote xml:lang="en">Parent not specified.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The previous local name fria-FRIAQuestionnaire did not follow the module-prefix convention and has been normalised to eu-aiact-FRIAQuestionnaire.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIATool -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-aiact-FRIATool">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">FRIA Tool</skos:prefLabel>
        <skos:notation>eu-aiact-FRIATool</skos:notation>
        <skos:definition xml:lang="en">A concept extending dpv:Technology that represents a tool used to facilitate deployers in complying with their FRIA obligations, as provided for in AI Act Article 27-5. Its involvement in FRIA steps is expressed using dpv:isImplementedUsingTechnology. Enables modelling of tool modality, stakeholders, and related data via DPV TECH extension concepts.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
        <skos:note xml:lang="en">Proposed for: DPV AI Act extension (eu-aiact)</skos:note>
        <skos:note xml:lang="en">Source condition: Assessment Process</skos:note>
        <skos:note xml:lang="en">Source: AI Act Article 27-5</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#aiact-FRIATool</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name aiact-FRIATool did not follow the module-prefix convention and has been normalised to eu-aiact-FRIATool.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-hasContractualTerms -->

    <rdf:Property rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-hasContractualTerms">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">has contractual terms</skos:prefLabel>
        <rdfs:label xml:lang="en">has contractual terms</rdfs:label>
        <skos:notation>dpv-hasContractualTerms</skos:notation>
        <skos:definition xml:lang="en">Indicates the contractual terms or obligations that apply to the processing or to a location.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dpv#hasContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT (conditions C64)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-hasContractualTerms</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Used as a property in C64; typed here as rdf:Property.</skos:editorialNote>
    </rdf:Property>

    <!-- https://tyttikatariina.github.io/HAPT/#hasExemptionBasis -->

    <rdf:Property rdf:about="https://tyttikatariina.github.io/HAPT/#hasExemptionBasis">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">has exemption basis</skos:prefLabel>
        <rdfs:label xml:lang="en">has exemption basis</rdfs:label>
        <skos:notation>hasExemptionBasis</skos:notation>
        <skos:definition xml:lang="en">Indicates the ground on which the processing is exempt from the obligation to carry out an impact assessment.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dpv#hasJustification"/>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN2, CN58)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#hasExemptionBasis</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Used as a property in CN2 and CN58; typed here as rdf:Property. Has no module prefix.</skos:editorialNote>
    </rdf:Property>

    <!-- https://tyttikatariina.github.io/HAPT/#legal-HorizontalPropertyLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#legal-HorizontalPropertyLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Horizontal Property Law</skos:prefLabel>
        <skos:notation>legal-HorizontalPropertyLaw</skos:notation>
        <skos:definition xml:lang="en">Law governing the ownership of separate units in a multi-occupancy building, such as Spanish Law 49/1960 on Horizontal Property.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Law"/>
        <skos:note xml:lang="en">Proposed for: DPV legal extension (legal)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN63)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#legal-HorizontalPropertyLaw</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Uses the module prefix legal-, which no other HAPT or IMPACTO term uses.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-isExpressedInLanguage -->

    <rdf:Property rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-isExpressedInLanguage">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">is expressed in language</skos:prefLabel>
        <rdfs:label xml:lang="en">is expressed in language</rdfs:label>
        <skos:notation>dpv-isExpressedInLanguage</skos:notation>
        <skos:definition xml:lang="en">Indicates the language in which the processing or its communications are carried out.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dpv#hasContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN34)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-isExpressedInLanguage</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Used as a property in CN34; typed here as rdf:Property.</skos:editorialNote>
    </rdf:Property>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LegalBasisExemption -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LegalBasisExemption">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Legal Basis Exemption</skos:prefLabel>
        <skos:notation>dpv-LegalBasisExemption</skos:notation>
        <skos:definition xml:lang="en">An exemption from an obligation which arises because the specific processing operation is regulated by EU or Member State law and the obligation was already discharged as part of the establishment of that legal basis.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalBasis"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN3)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LegalBasisExemption</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LegalRequirement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LegalRequirement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Legal Requirement</skos:prefLabel>
        <skos:notation>dpv-LegalRequirement</skos:notation>
        <skos:definition xml:lang="en">A requirement laid down by law that the processing is necessary to comply with.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalBasis"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN60)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LegalRequirement</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LocalGovernmentLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LocalGovernmentLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Local Government Law</skos:prefLabel>
        <skos:notation>dpv-LocalGovernmentLaw</skos:notation>
        <skos:definition xml:lang="en">A legal obligation laid down in local government law which requires or regulates the processing of personal data.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalObligation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN58)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LocalGovernmentLaw</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonsPreventativeProtection -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonsPreventativeProtection">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Persons Preventative Protection</skos:prefLabel>
        <skos:notation>dpv-PersonsPreventativeProtection</skos:notation>
        <skos:definition xml:lang="en">A measure serving the preventive protection of persons on private property used for residential purposes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PhysicalMeasure"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonsPreventativeProtection</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ProfessionalSecrecyObligation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ProfessionalSecrecyObligation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Professional Secrecy Obligation</skos:prefLabel>
        <skos:notation>dpv-ProfessionalSecrecyObligation</skos:notation>
        <skos:definition xml:lang="en">An obligation of professional secrecy binding a practitioner in respect of information obtained in the exercise of their professional activities.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalObligation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN52, CN53)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ProfessionalSecrecyObligation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PropertyPreventativeProtection -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PropertyPreventativeProtection">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Property Preventative Protection</skos:prefLabel>
        <skos:notation>dpv-PropertyPreventativeProtection</skos:notation>
        <skos:definition xml:lang="en">A measure serving the preventive protection of things or property on private property used for residential purposes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PhysicalMeasure"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PropertyPreventativeProtection</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-RiskLevelNotHigh -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-RiskLevelNotHigh">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Risk Level Not High</skos:prefLabel>
        <skos:notation>dpv-RiskLevelNotHigh</skos:notation>
        <skos:definition xml:lang="en">A risk level indicating that processing is not likely to result in a high risk to the rights and freedoms of natural persons.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#RiskLevel"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN1)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-RiskLevelNotHigh</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-StateLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-StateLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">State Law</skos:prefLabel>
        <skos:notation>dpv-StateLaw</skos:notation>
        <skos:definition xml:lang="en">Law enacted at the level of a constituent state or province of a federal state.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Law"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-StateLaw</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-StatutoryAuthorisation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-StatutoryAuthorisation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Statutory Authorisation</skos:prefLabel>
        <skos:notation>dpv-StatutoryAuthorisation</skos:notation>
        <skos:definition xml:lang="en">An authorisation granted by statute which permits processing that would otherwise be restricted, such as the processing of special categories of personal data or data relating to criminal convictions and offences.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Justification"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN9)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-StatutoryAuthorisation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-UnionLaw -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-UnionLaw">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Union Law</skos:prefLabel>
        <skos:notation>dpv-UnionLaw</skos:notation>
        <skos:definition xml:lang="en">Law of the European Union.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Law"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-UnionLaw</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ViolationOccured -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ViolationOccured">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Violation Occured</skos:prefLabel>
        <skos:notation>dpv-ViolationOccured</skos:notation>
        <skos:definition xml:lang="en">Status indicating that a violation of law has already occurred at a location.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Status"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ViolationOccured</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The local name is misspelt (Occured); consider correcting it to Occurred.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-WhiteListActivity -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-WhiteListActivity">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">White List Activity</skos:prefLabel>
        <skos:notation>dpv-WhiteListActivity</skos:notation>
        <skos:definition xml:lang="en">A processing activity included on the optional list established by a supervisory authority of operations for which no DPIA is required.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DPIA"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN4)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-WhiteListActivity</skos:changeNote>
    </skos:Concept>
</rdf:RDF>
