        <skos:prefLabel xml:lang="en">Petition List</skos:prefLabel>
        <skos:notation>dpv-PetitionList</skos:notation>
        <skos:definition xml:lang="en">Lists recording the individuals who have signed a petition.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN24)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-PetitionLists</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-PetitionList; the previous index named this term pd-PetitionLists. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-PriorViolations -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-PriorViolations">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Prior Violations</skos:prefLabel>
        <skos:notation>pd-PriorViolations</skos:notation>
        <skos:definition xml:lang="en">Data concerning violations of law that have already occurred at a location, relied upon to justify preventive protection measures.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Criminal"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-PriorViolations</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Public -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Public">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public</skos:prefLabel>
        <skos:notation>pd-Public</skos:notation>
        <skos:definition xml:lang="en">Personal data concerning members of the general public who come into contact with a public information or public relations service.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Social"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN29)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Public</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-PublicHealthData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-PublicHealthData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Health Data</skos:prefLabel>
        <skos:notation>pd-PublicHealthData</skos:notation>
        <skos:definition xml:lang="en">Personal data processed in the context of public health objectives, including epidemiological data at the population level.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#MedicalHealth"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: FR, GR, HU, NL (conditions C39)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-PublicHealthData</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Signatory -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Signatory">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Signatory</skos:prefLabel>
        <skos:notation>pd-Signatory</skos:notation>
        <skos:definition xml:lang="en">Personal data identifying an individual as a signatory to a citizens' initiative, petition or signature collection.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN24)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Signatory</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Skills -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Skills">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Skills</skos:prefLabel>
        <skos:notation>pd-Skills</skos:notation>
        <skos:definition xml:lang="en">Personal data processed for the systematic assessment of an individual's capabilities or expertise, including the evaluation of specific learned abilities, aptitudes, or training outcomes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#External"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IS, NO, PL (conditions C45)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Skill</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use pd-Skills; the previous index named this term pd-Skill. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-SocialSecurity -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-SocialSecurity">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Social Security</skos:prefLabel>
        <skos:notation>pd-SocialSecurity</skos:notation>
        <skos:definition xml:lang="en">Personal data concerning an individual's social security registration and contributions.</skos:definition>
        <skos:scopeNote xml:lang="en">The analysis notes that related official identifiers, such as passport numbers, could be added alongside this concept.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN63)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-SocialSecurity</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#tech-StationaryImages -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#tech-StationaryImages">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Stationary Images</skos:prefLabel>
        <skos:notation>tech-StationaryImages</skos:notation>
        <skos:definition xml:lang="en">Image data captured by stationary (fixed) cameras, such as in video surveillance.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-ImageData"/>
        <skos:note xml:lang="en">Proposed for: DPV technology extension (tech)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN16)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#tech-StationaryImages</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-TimeAtWork -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-TimeAtWork">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Time At Work</skos:prefLabel>
        <skos:notation>pd-TimeAtWork</skos:notation>
        <skos:definition xml:lang="en">Personal data recording the time an individual spends at work, as produced by working time calculation and scheduling systems.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Professional"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN50)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-TimeAtWork</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Travel -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Travel">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Travel</skos:prefLabel>
        <skos:notation>pd-Travel</skos:notation>
        <skos:definition xml:lang="en">Personal data concerning an individual's travel, including trips and stays organised in connection with an event.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-b"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required; Annex III</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN31); AI Act Annex III, point 7(b) (Recital 60)</skos:note>
        <skos:note xml:lang="en">Annex III wording: travel data</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Travel</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Trustworthiness -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Trustworthiness">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Trustworthiness</skos:prefLabel>
        <skos:notation>pd-Trustworthiness</skos:notation>
        <skos:definition xml:lang="en">Personal data processed to predict or assess an individual's reliability, integrity, or honesty, often in the context of providing services, financial products, or employment assessments.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#External"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: EE, FI, NO (conditions C61)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Trustworthiness</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-UnionLevelRegisters -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-UnionLevelRegisters">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Union Level Registers</skos:prefLabel>
        <skos:notation>dpv-UnionLevelRegisters</skos:notation>
        <skos:definition xml:lang="en">Registers established at Union level under Union law.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Data"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-UnionLevelRegisters</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-UnlawfulActivity -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-UnlawfulActivity">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Unlawful Activity</skos:prefLabel>
        <skos:notation>pd-UnlawfulActivity</skos:notation>
        <skos:definition xml:lang="en">Unlawful activity under GDPR refers to any unlawful activity that violates laws and regulations.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Social"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: DPIA Required lists of all Member States (conditions C10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-UnlawfulActivity</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-VideoData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-VideoData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Video Data</skos:prefLabel>
        <skos:notation>dpv-VideoData</skos:notation>
        <skos:definition xml:lang="en">Data consisting of moving images, including recordings produced by video surveillance systems.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN15)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-VideoData</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Vote -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Vote">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Vote</skos:prefLabel>
        <skos:notation>pd-Vote</skos:notation>
        <skos:definition xml:lang="en">Personal data concerning an individual's registration to vote and their participation in an electoral process.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-VotingBehaviourInfluencing"/>
