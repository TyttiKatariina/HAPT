    <!-- https://tyttikatariina.github.io/HAPT/#sector-law-EvidenceReliabilityEvaluation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-law-EvidenceReliabilityEvaluation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Evidence Reliability Evaluation</skos:prefLabel>
        <skos:notation>sector-law-EvidenceReliabilityEvaluation</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with evaluating the reliability of evidence in the course of the investigation or prosecution of criminal offences, or in the examination of applications for asylum, visa or residence permits.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/law#LegalInvestigation"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/law#LegalEvidenceEligibilityAssessment"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/law#ImmigrationClaimVerification"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-6-c"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-c"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 6(c), 7(c) (Recital 60; Recitals 59, 159)</skos:note>
        <skos:note xml:lang="en">Annex III wording: evaluate reliability of evidence; assessment of reliability of evidence</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

