        <skos:prefLabel xml:lang="en">Legal Duties</skos:prefLabel>
        <skos:notation>sector-law-LegalDuties</skos:notation>
        <skos:definition xml:lang="en">The performance of duties imposed on an officer of a court, such as the clerks of commercial courts.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN46, CN47)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-law-LegalDuties</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LegalObligationFulfillment -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LegalObligationFulfillment">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Legal Obligation Fulfillment</skos:prefLabel>
        <skos:notation>dpv-LegalObligationFulfillment</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with fulfilling an obligation laid down by law, such as obligations in the fields of social security, health insurance and taxation.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#FulfilmentOfObligation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN32)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LegalObligationFulfillment</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV spells the parent FulfilmentOfObligation; consider spelling this term Fulfilment.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LinkingPersonalData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LinkingPersonalData">
