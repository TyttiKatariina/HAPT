    <!-- https://tyttikatariina.github.io/HAPT/#dpv-HistoricalResearch -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-HistoricalResearch">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Historical Research</skos:prefLabel>
        <skos:notation>dpv-HistoricalResearch</skos:notation>
        <skos:definition xml:lang="en">Processing of personal data for historical research purposes.</skos:definition>
        <skos:scopeNote xml:lang="en">Overlaps with hapt:dpv-HistoricResearch; the two entries should be reconciled before publication.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN23)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-HistoricalResearch</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-HistoricResearch -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-HistoricResearch">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Historic Research</skos:prefLabel>
        <skos:notation>dpv-HistoricResearch</skos:notation>
        <skos:definition xml:lang="en">The processing of personal data for scientific or historical research purposes, conducted without the data subject's consent, and in conjunction with at least one of the legal criteria under the GDPR, such as being necessary for a task carried out in the public interest.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ResearchAndDevelopment"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, LT, LU, NO, PT, SK (conditions C30)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-HistoricResearcha</skos:changeNote>
        <skos:editorialNote xml:lang="en">Term corrected from "HistoricResearcha" in the previous index.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-HistoricResearch; the previous index named this term dpv-HistoricResearcha. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Identification -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Identification">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Identification</skos:prefLabel>
        <skos:notation>dpv-Identification</skos:notation>
        <skos:definition xml:lang="en">Processing carried out to identify an individual or to make the identity of the responsible controller apparent.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Identification</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-InternalAdministration -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-InternalAdministration">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Internal Administration</skos:prefLabel>
        <skos:notation>dpv-InternalAdministration</skos:notation>
        <skos:definition xml:lang="en">The administration of personnel internal to an organisation for purposes made mandatory by law, such as accounting, human resources management, payroll, social security and workplace safety.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN62, CN63)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-InternalAdministrationManagement</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-InternalAdministration; the previous index named this term dpv-InternalAdministrationManagement. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-publicservices-IntroducingEGovernmentServices -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-publicservices-IntroducingEGovernmentServices">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Introducing E-Government Services</skos:prefLabel>
        <skos:notation>sector-publicservices-IntroducingEGovernmentServices</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with introducing new e-government services.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#sector-publicservices-ProvidingEGovernmentServices"/>
        <skos:note xml:lang="en">Proposed for: DPV public services sector extension (sector-publicservices)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: GR (conditions C82)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-publicservices-IntroducingEGovernmentServices</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-InventoryManagement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-InventoryManagement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Inventory Management</skos:prefLabel>
        <skos:notation>dpv-InventoryManagement</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with managing the inventory of an organisation, such as the issue, return and allocation of goods, hardware and software.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#OrganisationGovernance"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN12)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-InventoryManagement</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV 2.3 has dpv:DataInventoryManagement, which concerns data inventories rather than goods.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Invitations -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Invitations">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Invitations</skos:prefLabel>
        <skos:notation>dpv-Invitations</skos:notation>
        <skos:definition xml:lang="en">The issuing of invitations to prospective participants of an event.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-EventManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30, CN31)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Invitations</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-law-JudicialFactResearch -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-law-JudicialFactResearch">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Judicial Fact Research</skos:prefLabel>
        <skos:notation>sector-law-JudicialFactResearch</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with assisting a judicial authority in researching facts.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/law#JudicialSystemManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/law#JudicialLegalInterpretation"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-8-a"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 8(a) (Recital 61)</skos:note>
        <skos:note xml:lang="en">Annex III wording: researching facts</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LabourBrokeringService -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LabourBrokeringService">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Labour Brokering Service</skos:prefLabel>
        <skos:notation>dpv-LabourBrokeringService</skos:notation>
        <skos:definition xml:lang="en">Service that facilitates labour provision through a brokering process, including matching workers with jobs or facilitating labour based on demand.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#HumanResourceManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: EE (conditions C105)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LabourBrokeringService</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LandManagement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LandManagement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Land Management</skos:prefLabel>
        <skos:notation>dpv-LandManagement</skos:notation>
        <skos:definition xml:lang="en">The management of land associated with residential buildings held by an association or community of apartment owners.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN55)</skos:note>
