    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-MunicipalityAssociations">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Municipality Associations</skos:prefLabel>
        <skos:notation>dpv-MunicipalityAssociations</skos:notation>
        <skos:definition xml:lang="en">An association of municipalities constituted as a body governed by public law.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN26)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-MunicipalityAssociations</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Nominee -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Nominee">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Nominee</skos:prefLabel>
        <skos:notation>dpv-Nominee</skos:notation>
        <skos:definition xml:lang="en">An individual nominated by another for a prize, decoration or similar award.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSubject"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN32)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Nominee</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Notaries -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Notaries">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Notaries</skos:prefLabel>
        <skos:notation>dpv-Notaries</skos:notation>
        <skos:definition xml:lang="en">A legal professional authorised to draft, authenticate and certify documents and to carry out notarial activities.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Notaries</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The condition files also use the variant hapt:dpv-Notary for this concept; it is listed separately as an exact match so that it resolves.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Notary -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Notary">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Notaries</skos:prefLabel>
        <skos:notation>dpv-Notary</skos:notation>
        <skos:definition xml:lang="en">A legal professional authorised to draft, authenticate and certify documents and to carry out notarial activities.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-Notaries"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN47, CN52)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Notary</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Same concept as hapt:dpv-Notaries, written differently in the condition files. Kept as a separate term so that every concept in the condition files resolves; consider using one spelling in the condition files.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-OwnersAssociation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-OwnersAssociation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Owners Association</skos:prefLabel>
        <skos:notation>dpv-OwnersAssociation</skos:notation>
        <skos:definition xml:lang="en">An association or sub-association of owners in a multi-occupancy property, constituted for the management of that property.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN63, CN64)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-OwnerAssociation</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-OwnersAssociation; the previous index named this term dpv-OwnerAssociation. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-OwnersSubAssociation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-OwnersSubAssociation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Owners Sub Association</skos:prefLabel>
        <skos:notation>dpv-OwnersSubAssociation</skos:notation>
        <skos:definition xml:lang="en">A sub-association of the owners of a multi-occupancy property, as defined in Spanish Law 49/1960 on Horizontal Property.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-OwnersAssociation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN63)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-OwnersSubAssociation</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Parternship -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Parternship">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Partnership</skos:prefLabel>
        <skos:notation>dpv-Parternship</skos:notation>
        <skos:definition xml:lang="en">An association of two or more persons who carry on an activity together, such as a partnership under private law.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Parternship</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The local name is misspelt (Parternship); consider correcting it to Partnership in the condition files and here.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PatentLawyer -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PatentLawyer">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Patent Lawyer</skos:prefLabel>
        <skos:notation>dpv-PatentLawyer</skos:notation>
        <skos:definition xml:lang="en">A legal professional specialising in the drafting and prosecution of patents and other intellectual property rights.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PatentLawyer</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonnelInTraining -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonnelInTraining">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personnel In Training</skos:prefLabel>
        <skos:notation>dpv-PersonnelInTraining</skos:notation>
        <skos:definition xml:lang="en">A person undergoing training within an organisation in connection with their employment or service relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonnelInTraining</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PetitionOrganiser -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PetitionOrganiser">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Petition Organiser</skos:prefLabel>
        <skos:notation>dpv-PetitionOrganiser</skos:notation>
        <skos:definition xml:lang="en">An organisation or individual that organises a petition or signature collection and processes the personal data of signatories.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN24)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PetitionOrganisers</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-PetitionOrganiser; the previous index named this term dpv-PetitionOrganisers. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-health-Pharmacy -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-health-Pharmacy">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Pharmacy</skos:prefLabel>
        <skos:notation>sector-health-Pharmacy</skos:notation>
        <skos:definition xml:lang="en">A pharmacy providing health services and processing patient and client data in doing so.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV health sector extension (sector-health)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN21, CN44)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-health-Pharmacy</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Physician -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Physician">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Physician</skos:prefLabel>
        <skos:notation>dpv-Physician</skos:notation>
        <skos:definition xml:lang="en">A physician working on an individual basis in the exercise of their professional duties.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN61, CN62)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-health-Physician</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-Physician; the previous index named this term sector-health-Physician. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Police -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Police">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Police</skos:prefLabel>
        <skos:notation>dpv-Police</skos:notation>
        <skos:definition xml:lang="en">A police service acting as an emergency first response service.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LawEnforcementOrganisation"/>
        <skos:broader rdf:resource="https://w3id.org/dpv#EmergencyServiceProvider"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-d"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5(d) (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: police</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PrivateSponsors -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PrivateSponsors">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Private Sponsors</skos:prefLabel>
        <skos:notation>dpv-PrivateSponsors</skos:notation>
        <skos:definition xml:lang="en">A private entity that sponsors or funds the activities of an association, partnership or similar body.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PrivateSponsors</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PrivateUtilityProvider -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PrivateUtilityProvider">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Private Utility Provider</skos:prefLabel>
        <skos:notation>dpv-PrivateUtilityProvider</skos:notation>
        <skos:definition xml:lang="en">A private organisation providing utilities.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-UtilityProvider"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Not recorded</skos:note>
        <skos:note xml:lang="en">Source: Source not recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PrivateUtilityProvider</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ProfessionalCollege -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ProfessionalCollege">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Professional College</skos:prefLabel>
        <skos:notation>dpv-ProfessionalCollege</skos:notation>
        <skos:definition xml:lang="en">A professional body under public law that represents and regulates the members of a profession.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN64)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ProfessionalCollege</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PropertyOwner -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PropertyOwner">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Property Owner</skos:prefLabel>
        <skos:notation>dpv-PropertyOwner</skos:notation>
        <skos:definition xml:lang="en">The owner of a property who determines the processing carried out in relation to it.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PropertyOwner</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicAuthority -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicAuthority">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Authority</skos:prefLabel>
        <skos:notation>dpv-PublicAuthority</skos:notation>
        <skos:definition xml:lang="en">A public authority, or an entity acting on its behalf, that evaluates eligibility for or grants, reduces, revokes or reclaims essential public assistance benefits and services.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#GovernmentalOrganisation"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-a"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 5(a) (Recital 58)</skos:note>
        <skos:note xml:lang="en">Annex III wording: public authorities</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicLawBody -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicLawBody">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Law Body</skos:prefLabel>
        <skos:notation>dpv-PublicLawBody</skos:notation>
        <skos:definition xml:lang="en">A body governed by public law, such as an authority, a public corporation or a public institution.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#GovernmentalOrganisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN26)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicLawBody</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicOfficials -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicOfficials">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Officials</skos:prefLabel>
        <skos:notation>dpv-PublicOfficials</skos:notation>
        <skos:definition xml:lang="en">An individual holding public office who, together with their supporting apparatus, processes personal data in the course of public relations and the provision of information.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN28, CN29)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicOfficials</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicServant -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicServant">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Servant</skos:prefLabel>
        <skos:notation>dpv-PublicServant</skos:notation>
        <skos:definition xml:lang="en">A person employed or paid by a body responsible for the public sector.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicServant</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicSponsors -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicSponsors">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Sponsors</skos:prefLabel>
        <skos:notation>dpv-PublicSponsors</skos:notation>
        <skos:definition xml:lang="en">A public entity that sponsors or funds the activities of an association, partnership or similar body.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicSponsors</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicUtilityProvider -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicUtilityProvider">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Utility Provider</skos:prefLabel>
        <skos:notation>dpv-PublicUtilityProvider</skos:notation>
        <skos:definition xml:lang="en">A public organisation providing utilities.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-UtilityProvider"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, HR, GR, HU, NL, PL, RO (conditions C23)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicUtilityProvider</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Refugee -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Refugee">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Refugee</skos:prefLabel>
        <skos:notation>dpv-Refugee</skos:notation>
        <skos:definition xml:lang="en">A natural person granted or seeking international protection whose rights are represented by the authority processing their data.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSubject"/>
        <skos:related rdf:resource="https://w3id.org/dpv#AsylumSeeker"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#pd-AsylumData"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN58)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Refugee</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-RegisteredVoter -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-RegisteredVoter">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Registered Voter</skos:prefLabel>
        <skos:notation>dpv-RegisteredVoter</skos:notation>
        <skos:definition xml:lang="en">A citizen entered on an electoral register and thereby entitled to vote.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#HumanSubject"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-VotingBehaviourInfluencing"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN42)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-RegisteredVoter</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Resident -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Resident">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Resident</skos:prefLabel>
        <skos:notation>dpv-Resident</skos:notation>
        <skos:definition xml:lang="en">A natural person residing within the territory of an authority, irrespective of citizenship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSubject"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN58)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Resident</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SelfEmployedHealthcarePractitioner -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SelfEmployedHealthcarePractitioner">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Self Employed Healthcare Practitioner</skos:prefLabel>
        <skos:notation>dpv-SelfEmployedHealthcarePractitioner</skos:notation>
        <skos:definition xml:lang="en">An individual healthcare practitioner working on a self-employed basis in the exercise of their professional duties.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN37)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SelfEmployedHealthcarePractitioner</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SelfEmployedHealthcareProfessional -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SelfEmployedHealthcareProfessional">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Self Employed Healthcare Professional</skos:prefLabel>
        <skos:notation>dpv-SelfEmployedHealthcareProfessional</skos:notation>
        <skos:definition xml:lang="en">A person authorised to provide healthcare services who is not in an employment relationship and who processes personal data solely to provide those services to the data subject.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN37)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SelfEmployedHealthcareProfessional</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SelfEmployedPersonnel -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SelfEmployedPersonnel">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Self Employed Personnel</skos:prefLabel>
        <skos:notation>dpv-SelfEmployedPersonnel</skos:notation>
        <skos:definition xml:lang="en">A person working on an individual basis in the exercise of their professional duties and not in an employment relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN61, CN62)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SelfEmployedPerson</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-SelfEmployedPersonnel; the previous index named this term dpv-SelfEmployedPerson. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ServiceCustomer -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ServiceCustomer">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Service Customer</skos:prefLabel>
        <skos:notation>dpv-ServiceCustomer</skos:notation>
        <skos:definition xml:lang="en">A natural or legal person who receives services from the controller.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Customer"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ServiceCustomer</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ServiceSupplier -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ServiceSupplier">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Service Supplier</skos:prefLabel>
        <skos:notation>dpv-ServiceSupplier</skos:notation>
        <skos:definition xml:lang="en">An entity that supplies goods or services to an organisation within a business relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ServiceSupplier</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SignatureCollector -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SignatureCollector">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Signature Collector</skos:prefLabel>
        <skos:notation>dpv-SignatureCollector</skos:notation>
        <skos:definition xml:lang="en">A person or organisation that organises the collection of signatures, for example for a citizens’ initiative or petition.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN24)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SignatureCollector</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SocialServiceProvider -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SocialServiceProvider">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Social Service Provider</skos:prefLabel>
        <skos:notation>dpv-SocialServiceProvider</skos:notation>
        <skos:definition xml:lang="en">A person or organisation that provides social services.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN38)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SocialServiceProvider</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-StaffOnContract -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-StaffOnContract">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Staff On Contract</skos:prefLabel>
        <skos:notation>dpv-StaffOnContract</skos:notation>
        <skos:definition xml:lang="en">A person engaged by an organisation under a contract for services or a fixed-term contract of employment.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-StaffOnContract</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-StateAuthorities -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-StateAuthorities">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">State Authorities</skos:prefLabel>
        <skos:notation>dpv-StateAuthorities</skos:notation>
        <skos:definition xml:lang="en">An authority established under the law of a state and exercising public powers within it.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN9)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-StateAuthorities</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SubscribedMembers -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SubscribedMembers">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Subscribed Members</skos:prefLabel>
        <skos:notation>dpv-SubscribedMembers</skos:notation>
        <skos:definition xml:lang="en">An individual who has subscribed to membership of a body and in respect of whom membership and fee records are maintained.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SubscribedMembers</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SwornBailiffs -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SwornBailiffs">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Sworn Bailiffs</skos:prefLabel>
        <skos:notation>dpv-SwornBailiffs</skos:notation>
        <skos:definition xml:lang="en">An officer sworn to enforce judgments and carry out related legal acts, working individually in the exercise of their professional activities.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN52, CN53)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SwornBailiffs</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-TaxConsultants -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-TaxConsultants">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Tax Consultants</skos:prefLabel>
        <skos:notation>dpv-TaxConsultants</skos:notation>
        <skos:definition xml:lang="en">A professional providing tax advice and related services to clients.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-TaxConsultants</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-TemporaryStaff -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-TemporaryStaff">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Temporary Staff</skos:prefLabel>
        <skos:notation>dpv-TemporaryStaff</skos:notation>
        <skos:definition xml:lang="en">A person engaged by an organisation on a temporary basis.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-TemporaryStaff</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-UninvolvedPerson -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-UninvolvedPerson">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Uninvolved Person</skos:prefLabel>
        <skos:notation>dpv-UninvolvedPerson</skos:notation>
        <skos:definition xml:lang="en">A natural person who is not involved in the activity for which the processing is carried out, such as a passer-by captured in a recording.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSubject"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-UninvolvedPerson</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-UnionAuthorities -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-UnionAuthorities">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Union Authorities</skos:prefLabel>
        <skos:notation>dpv-UnionAuthorities</skos:notation>
        <skos:definition xml:lang="en">An authority established under Union law and exercising public powers at Union level.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN9)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-UnionAuthorities</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-UtilityProvider -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-UtilityProvider">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Utility Provider</skos:prefLabel>
        <skos:notation>dpv-UtilityProvider</skos:notation>
        <skos:definition xml:lang="en">An organisation (public or private) that processes personal data in the provision of utilities.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: No source recorded for this concept; the source conditions shown are those of its narrower concepts: dpv-PrivateUtilityProvider, dpv-PublicUtilityProvider.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-UtilityProvider</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-VocationalTrainingInstitution -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-VocationalTrainingInstitution">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Vocational Training Institution</skos:prefLabel>
        <skos:notation>dpv-VocationalTrainingInstitution</skos:notation>
        <skos:definition xml:lang="en">An institution providing vocational training at any level.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#EducationalOrganisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 3 (Recital 56)</skos:note>
        <skos:note xml:lang="en">Annex III wording: vocational training institution of all levels</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>
    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data Categories
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AnnualFinancialStatements -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AnnualFinancialStatements">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Annual Financial Statements</skos:prefLabel>
        <skos:notation>dpv-AnnualFinancialStatements</skos:notation>
        <skos:definition xml:lang="en">Financial statements prepared for a financial year, such as the balance sheet and profit and loss account.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-FinancialStatements"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN25)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AnnualFinancialStatements</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-AssessmentOutcome -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-AssessmentOutcome">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Assessment Outcome</skos:prefLabel>
        <skos:notation>pd-AssessmentOutcome</skos:notation>
        <skos:definition xml:lang="en">Personal data that captures results or conclusions from standardised assessments, such as exams, evaluations, or diagnostic tests, aimed at determining skills, knowledge, mental health, or developmental status.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#External"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/education#StudentLearningOutcomeAssessment"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IS, NO, PL</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-AssessmentOutcome</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-AsylumData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-AsylumData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Asylum Data</skos:prefLabel>
        <skos:notation>pd-AsylumData</skos:notation>
        <skos:definition xml:lang="en">Personal data contained in or relating to an application for asylum, processed in the examination of that application.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <skos:related rdf:resource="https://w3id.org/dpv#AsylumSeeker"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-Refugee"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-c"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 7(c) (Recital 60)</skos:note>
        <skos:note xml:lang="en">Annex III wording: asylum data</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AudioData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AudioData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Audio Data</skos:prefLabel>
        <skos:notation>dpv-AudioData</skos:notation>
        <skos:definition xml:lang="en">Data consisting of acoustic recordings, including those associated with image processing for monitoring purposes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN16)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AudioData</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-BadConduct -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-BadConduct">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Bad Conduct</skos:prefLabel>
        <skos:notation>pd-BadConduct</skos:notation>
        <skos:definition xml:lang="en">Broader term than criminal offences or unlawful conduct. It can include behaviour that may not be illegal but is still considered ethically or professionally inappropriate, controversial, or reputationally damaging.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#pd-Conduct"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: DPIA Required lists of all Member States (conditions C10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-BadConduct</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-BreathalyzerTestResult -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-BreathalyzerTestResult">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Breathalyzer Test Result</skos:prefLabel>
        <skos:notation>dpv-BreathalyzerTestResult</skos:notation>
        <skos:definition xml:lang="en">Information about the result of a breath alcohol test carried out on an individual.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN50, CN56)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-BreathalyzerTestResult</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-finance-BudgetData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-finance-BudgetData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Budget Data</skos:prefLabel>
        <skos:notation>sector-finance-BudgetData</skos:notation>
        <skos:definition xml:lang="en">Data concerning the budget of an organisation, used for budget control and strategic controlling.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Data"/>
        <skos:note xml:lang="en">Proposed for: DPV finance sector extension (sector-finance)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN25)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-finance-BudgetData</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-BusinessTransactions -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-BusinessTransactions">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Business Transactions</skos:prefLabel>
        <skos:notation>dpv-BusinessTransactions</skos:notation>
        <skos:definition xml:lang="en">Information about business transactions carried out between the controller and its customers, suppliers or other business partners.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Transactional"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-BusinessTransactions</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Career -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Career">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Career</skos:prefLabel>
        <skos:notation>pd-Career</skos:notation>
        <skos:definition xml:lang="en">Personal data related to an individual's professional progression, roles held, promotions, or career evaluations that may impact employment opportunities.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Professional"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: EE</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Career</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-CaseFiles -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-CaseFiles">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Case Files</skos:prefLabel>
        <skos:notation>pd-CaseFiles</skos:notation>
        <skos:definition xml:lang="en">Files compiled by a professional in respect of an individual client's case.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-CaseFiles</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Competency -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Competency">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Competency</skos:prefLabel>
        <skos:notation>pd-Competency</skos:notation>
        <skos:definition xml:lang="en">Personal data used in the systematic evaluation of an individual's overall effectiveness in applying knowledge and skills, including professional qualifications, behavioural performance, and domain-specific expertise.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#External"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IS, NO, PL (conditions C45)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Competency</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Conduct -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Conduct">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Conduct</skos:prefLabel>
        <skos:notation>pd-Conduct</skos:notation>
        <skos:definition xml:lang="en">A pattern or instance of individual behaviour, particularly in relation to lawfulness, ethics, professional standards, or social expectations. Conduct can be evaluated as good or bad based on its alignment with normative, legal, or reputational frameworks.</skos:definition>
        <skos:scopeNote xml:lang="en">The parent for bad conduct and good conduct.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#External"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: No source recorded for this concept; the source conditions shown are those of its narrower concepts: pd-BadConduct, pd-GoodConduct.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Conduct</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-CriminalConvictions -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-CriminalConvictions">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Criminal Convictions</skos:prefLabel>
        <skos:notation>pd-CriminalConvictions</skos:notation>
        <skos:definition xml:lang="en">Information about criminal convictions of an individual.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Criminal"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN27)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-CriminalConvictions</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV 2.3 has pd:CriminalConviction (singular); check whether it can be reused instead.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-CriminalOffences -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-CriminalOffences">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Criminal Offences</skos:prefLabel>
        <skos:notation>pd-CriminalOffences</skos:notation>
        <skos:definition xml:lang="en">Information about criminal offences committed by an individual.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Criminal"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN27)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-CriminalOffences</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV 2.3 has pd:CriminalOffence (singular); check whether it can be reused instead.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DataRegister -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DataRegister">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Data Register</skos:prefLabel>
        <skos:notation>dpv-DataRegister</skos:notation>
        <skos:definition xml:lang="en">A register or other structured record of data that is used as a source for processing, for example when data sets and registers are matched or combined.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required; DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT, CY, CZ, DK, FI, DE, GR, HU, IE, IT, LV, LI, LU, NO, PL, SI, ES, SE (conditions C15); Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DataSet -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DataSet">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Data Set</skos:prefLabel>
        <skos:notation>dpv-DataSet</skos:notation>
        <skos:definition xml:lang="en">A collection of data that is used as a source for processing, for example when separate data sets are matched or combined.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT, CY, CZ, DK, FI, DE, GR, HU, IE, IT, LV, LI, LU, NO, PL, SI, ES, SE (conditions C15, C95)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-DigitalTwin -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-DigitalTwin">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Digital Twin</skos:prefLabel>
        <skos:notation>pd-DigitalTwin</skos:notation>
        <skos:definition xml:lang="en">A digital representation of a real-world person, where personal data is processed to simulate, predict, or monitor behaviour, performance, or health.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#External"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: DK (conditions C84)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-DigitalTwin</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-ElectronicHealthCard -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-ElectronicHealthCard">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Electronic Health Card</skos:prefLabel>
        <skos:notation>pd-ElectronicHealthCard</skos:notation>
        <skos:definition xml:lang="en">A digital or physical card used to store or provide access to personal health data, as part of large-scale systematic processing for public health purposes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#HealthRecord"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: FR, GR, HU, NL (conditions C39)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-ElectronicHealthCard</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-ElectronicHealthRecord -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-ElectronicHealthRecord">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Electronic Health Record</skos:prefLabel>
        <skos:notation>pd-ElectronicHealthRecord</skos:notation>
        <skos:definition xml:lang="en">A digital record of a patient's medical history, diagnoses, medications, treatment plans, and other health-related information.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#HealthRecord"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: FR, GR, HU, NL (conditions C39)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-ElectronicHealthRecord</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ExpenseData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ExpenseData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Expense Data</skos:prefLabel>
        <skos:notation>dpv-ExpenseData</skos:notation>
        <skos:definition xml:lang="en">Data relating to the expenses of an organisation.</skos:definition>
        <skos:scopeNote xml:lang="en">Relates to the organisation rather than to the individual.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Data"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ExpenseData</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-FacialImages -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-FacialImages">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Facial Images</skos:prefLabel>
        <skos:notation>pd-FacialImages</skos:notation>
        <skos:definition xml:lang="en">Images of an individual's face, including the mere real-time reproduction of facial images where no biometric processing is carried out.</skos:definition>
        <skos:scopeNote xml:lang="en">Recorded in the analysis under dpv:DataSource; placement under pd:Biometric or a general image data category may be more appropriate.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN15)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-FacialImages</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-FileSystem -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-FileSystem">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">File System</skos:prefLabel>
        <skos:notation>dpv-FileSystem</skos:notation>
        <skos:definition xml:lang="en">A filing system, meaning any structured set of personal data which are accessible according to specific criteria (GDPR Art. 4(6)), used as a source for processing.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: CY (conditions C107)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-FileSystem</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-FinancialStatements -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-FinancialStatements">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Financial Statements</skos:prefLabel>
        <skos:notation>dpv-FinancialStatements</skos:notation>
        <skos:definition xml:lang="en">Formal records of the financial activities and position of an organisation, such as balance sheets and income statements.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Financial"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN25)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-FinancialStatements</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Gait -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Gait">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Gait</skos:prefLabel>
        <skos:notation>pd-Gait</skos:notation>
        <skos:definition xml:lang="en">Data capturing the manner in which an individual walks, as may be recorded by video surveillance.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN16)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Gait</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-GoodConduct -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-GoodConduct">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Good Conduct</skos:prefLabel>
        <skos:notation>pd-GoodConduct</skos:notation>
        <skos:definition xml:lang="en">Behaviour that is lawful, ethical, professional, reputation-enhancing or neutral and unlikely to cause social or professional harm.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#pd-Conduct"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: DPIA Required lists of all Member States</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-GoodConduct</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ImageData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ImageData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Image Data</skos:prefLabel>
        <skos:notation>dpv-ImageData</skos:notation>
        <skos:definition xml:lang="en">Data consisting of still images, including images captured by systems controlling access to buildings and delimited areas.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN15)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ImageData</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-IncomeData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-IncomeData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Income Data</skos:prefLabel>
        <skos:notation>dpv-IncomeData</skos:notation>
        <skos:definition xml:lang="en">Information about the income received by a natural person or an organisation in the context of business transactions.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Income"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-IncomeData</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Language -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Language">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Language</skos:prefLabel>
        <skos:notation>dpv-Language</skos:notation>
        <skos:definition xml:lang="en">The language in which a processing activity or communication is carried out.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataType"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN35)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Language</skos:changeNote>
        <skos:editorialNote xml:lang="en">Parent dpv:DataType was not found in DPV 2.3.; A concept with the same name already exists in DPV 2.3 (pd:Language); check whether it can be reused instead.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Legal -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Legal">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Legal</skos:prefLabel>
        <skos:notation>pd-Legal</skos:notation>
        <skos:definition xml:lang="en">Personal data relating to an individual's legal affairs, processed in the course of legal advisory services.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Legal</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-LocationDisplacement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-LocationDisplacement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Location Displacement</skos:prefLabel>
        <skos:notation>pd-LocationDisplacement</skos:notation>
        <skos:definition xml:lang="en">Personal data processed to analyse or predict a person's change in location, movement patterns, or relocation behaviours, often linked to economic or social factors.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#External"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#pd-MovementData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE (conditions C87)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-LocationDisplacement</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-LocationRoute -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-LocationRoute">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Location Route</skos:prefLabel>
        <skos:notation>pd-LocationRoute</skos:notation>
        <skos:definition xml:lang="en">Personal data representing an individual's travel path or movement behaviour, processed to predict interests, routines, or mobility patterns.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Location"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#pd-MovementData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: HR, EE, FI, DE, HU, IS, NO (conditions C37, C61)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-LocationRoute</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-MemberContact -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-MemberContact">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Member Contact</skos:prefLabel>
        <skos:notation>pd-MemberContact</skos:notation>
        <skos:definition xml:lang="en">Contact details of the members of an organisation.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Contact"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-MemberContact</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Membership -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Membership">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Membership</skos:prefLabel>
        <skos:notation>pd-Membership</skos:notation>
        <skos:definition xml:lang="en">Information about the membership of an individual in an organisation, such as evidence of membership and membership fees.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Membership</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-MigrationData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-MigrationData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Migration Data</skos:prefLabel>
        <skos:notation>pd-MigrationData</skos:notation>
        <skos:definition xml:lang="en">Personal data about a natural person's migration, processed in the context of migration, asylum and border control management.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <skos:related rdf:resource="https://w3id.org/dpv/pd#Residency"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-b"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 7(b) (Recital 60)</skos:note>
        <skos:note xml:lang="en">Annex III wording: migration data</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-MovementData -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-MovementData">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Movement Data</skos:prefLabel>
        <skos:notation>pd-MovementData</skos:notation>
        <skos:definition xml:lang="en">Personal data about the movements of a natural person, processed to assess a security, irregular migration or health risk posed by a person who intends to enter or has entered the territory of a Member State.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Location"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#pd-LocationRoute"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#pd-LocationDisplacement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-7-b"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 7(b) (Recital 60)</skos:note>
        <skos:note xml:lang="en">Annex III wording: movement data</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-NationalLanguage -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-NationalLanguage">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">National Language</skos:prefLabel>
        <skos:notation>dpv-NationalLanguage</skos:notation>
        <skos:definition xml:lang="en">The official or national language of a Member State, where processing is carried out exclusively in that language.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-Language"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN34, CN35)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-NationalLanguage</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-NationalLevelRegisters -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-NationalLevelRegisters">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">National Level Registers</skos:prefLabel>
        <skos:notation>dpv-NationalLevelRegisters</skos:notation>
        <skos:definition xml:lang="en">Registers established at national level under the law of a Member State.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Data"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-NationalLevelRegisters</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-OrganisationalTransactions -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-OrganisationalTransactions">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Organisational Transactions</skos:prefLabel>
        <skos:notation>dpv-OrganisationalTransactions</skos:notation>
        <skos:definition xml:lang="en">Data recording the business transactions of an organisation, as distinct from transaction data relating to an individual.</skos:definition>
        <skos:scopeNote xml:lang="en">Proposed as part of a possible group of data categories relating to an organisation or business rather than to an individual.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Data"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-OrganisationalTransactions</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Patent -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Patent">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Patent</skos:prefLabel>
        <skos:notation>dpv-Patent</skos:notation>
        <skos:definition xml:lang="en">Data relating to a patent held or applied for, processed in the course of professional practice.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#IntellectualPropertyData"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Patent</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#pd-Payroll -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#pd-Payroll">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Payroll</skos:prefLabel>
        <skos:notation>pd-Payroll</skos:notation>
        <skos:definition xml:lang="en">Information about the payroll of an employee, such as wages, deductions and contributions.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Salary"/>
        <skos:note xml:lang="en">Proposed for: DPV personal data extension (pd)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN6)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#pd-Payroll</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Overlaps with hapt:dpv-Payroll (purpose).</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataRegisters -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataRegisters">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personal Data Registers</skos:prefLabel>
        <skos:notation>dpv-PersonalDataRegisters</skos:notation>
        <skos:definition xml:lang="en">Registers, evidence or books containing personal data established under Union, federal or state law.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Data"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonalDataRegisters</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonnelRecords -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonnelRecords">
