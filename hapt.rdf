    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#ProceedingOrganisation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#ProceedingOrganisation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Proceeding Organisation</skos:prefLabel>
        <skos:notation>ProceedingOrganisation</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with organising formal proceedings, including large-scale proceedings, as part of the handling of business cases.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-CaseManagement"/>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN29)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#ProceedingOrganisation</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ProductDevelopment -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ProductDevelopment">
