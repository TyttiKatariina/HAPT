    <!-- https://tyttikatariina.github.io/HAPT/#sector-publicservices-ProvidingEGovernmentServices -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-publicservices-ProvidingEGovernmentServices">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Providing E-Government Services</skos:prefLabel>
        <skos:notation>sector-publicservices-ProvidingEGovernmentServices</skos:notation>
        <skos:definition xml:lang="en">The provision of electronic government services.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/publicservices#PublicServiceProvision"/>
        <skos:note xml:lang="en">Proposed for: DPV public services sector extension (sector-publicservices)</skos:note>
