        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-DetectiveAgency; the previous index named this term dpv-DetectiveAgencies. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Donor -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Donor">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Donor</skos:prefLabel>
        <skos:notation>dpv-Donor</skos:notation>
        <skos:definition xml:lang="en">A natural person who makes donations to an organisation, such as a professional college or a non-profit association.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSubject"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN64)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Donor</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Employer -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Employer">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Employer</skos:prefLabel>
        <skos:notation>dpv-Employer</skos:notation>
        <skos:definition xml:lang="en">An organisation that employs individuals and processes their personal data in connection with the employment relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN8)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Employer</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-EuropeanCommission -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-EuropeanCommission">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">European Commission</skos:prefLabel>
        <skos:notation>dpv-EuropeanCommission</skos:notation>
        <skos:definition xml:lang="en">The European Commission, acting in its capacity as the body that approves codes of conduct and related instruments.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Authority"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN60)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-EuropeanCommission</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-FederalAuthority -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-FederalAuthority">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Federal Authority</skos:prefLabel>
        <skos:notation>dpv-FederalAuthority</skos:notation>
        <skos:definition xml:lang="en">An authority established under federal law and exercising public powers at federal level.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN13)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-FederalAuthority</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-FederalGovernment -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-FederalGovernment">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Federal Government</skos:prefLabel>
        <skos:notation>dpv-FederalGovernment</skos:notation>
        <skos:definition xml:lang="en">The government of a federal state, acting as a body governed by public law.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
