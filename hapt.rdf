    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ProtectionOfPersons -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ProtectionOfPersons">
