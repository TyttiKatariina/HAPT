    <!-- https://tyttikatariina.github.io/HAPT/#dpv-EventManagement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-EventManagement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Event Management</skos:prefLabel>
        <skos:notation>dpv-EventManagement</skos:notation>
        <skos:definition xml:lang="en">Processing carried out for the holding of an event, including invitation and registration of participants, organisation of trips and stays, communication before and after the event, and settlement of monetary benefits.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30, CN31)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-EventManagement</skos:changeNote>
