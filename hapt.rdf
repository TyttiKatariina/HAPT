    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-law-LawApplicationToFacts -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-law-LawApplicationToFacts">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Law Application to Facts</skos:prefLabel>
        <skos:notation>sector-law-LawApplicationToFacts</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with assisting a judicial authority in applying the law to a concrete set of facts.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/law#JudicialSystemManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/law#JudicialDecisionMaking"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-8-a"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 8(a) (Recital 61)</skos:note>
        <skos:note xml:lang="en">Annex III wording: applying law to concrete set of facts</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-education-LearningProcessSteering -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-education-LearningProcessSteering">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Learning Process Steering</skos:prefLabel>
        <skos:notation>sector-education-LearningProcessSteering</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with steering the learning process of natural persons in educational and vocational training institutions, including on the basis of evaluated learning outcomes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/education#StudentManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/education#StudentLearningOutcomeAssessment"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-3-b"/>
        <skos:note xml:lang="en">Proposed for: DPV education sector extension (sector-education)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 3(b) (Recital 56)</skos:note>
        <skos:note xml:lang="en">Annex III wording: steering learning process; steer learning process of natural persons</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LegalAdvisoryServices -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LegalAdvisoryServices">
