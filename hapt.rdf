        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Task Allocation</skos:prefLabel>
        <skos:notation>dpv-TaskAllocation</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with allocating tasks to workers based on individual behaviour or personal traits or characteristics.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#BehaviourAnalysis"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#PersonalityTraitAnalysis"/>
