        <skos:prefLabel xml:lang="en">Heating Supply Management</skos:prefLabel>
        <skos:notation>dpv-HeatingSupplyManagement</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with the management of the supply of heating.</skos:definition>
