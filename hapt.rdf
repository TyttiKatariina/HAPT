    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Automated -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Automated">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Automated</skos:prefLabel>
        <skos:notation>dpv-Automated</skos:notation>
        <skos:definition xml:lang="en">Processing context indicating that automation is involved and parent concept for all automation-related processing contexts.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: DPIA Required lists of all Member States (conditions C8)</skos:note>
