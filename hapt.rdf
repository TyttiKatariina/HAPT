        <skos:notation>sector-health-HealthCareProvision</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with providing healthcare services to patients.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
        <skos:note xml:lang="en">Proposed for: DPV health sector extension (sector-health)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN36)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-health-HealthCareProvision</skos:changeNote>
