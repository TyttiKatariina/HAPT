        <skos:notation>dpv-FeeSettlement</skos:notation>
        <skos:definition xml:lang="en">The settlement of fees regulated under public law by bodies governed by public law.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/finance#FinancialServiceManagement"/>
        <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/HAPT/#sector-finance-FeeSettlement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN29)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-FeeSettlement</skos:changeNote>
        <skos:editorialNote xml:lang="en">Same concept as hapt:sector-finance-FeeSettlement, written differently in the condition files. Kept as a separate term so that every concept in the condition files resolves; consider using one spelling in the condition files.</skos:editorialNote>
    </skos:Concept>

