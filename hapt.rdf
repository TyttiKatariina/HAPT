        <skos:prefLabel xml:lang="en">Personnel Records</skos:prefLabel>
        <skos:notation>dpv-PersonnelRecords</skos:notation>
        <skos:definition xml:lang="en">Records kept about the employees of an organisation in connection with the employment relationship.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv/pd#Professional"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN33)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonnelRecords</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PetitionList -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PetitionList">
