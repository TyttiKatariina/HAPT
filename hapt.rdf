    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CivicEngagement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CivicEngagement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Civic Engagement</skos:prefLabel>
        <skos:notation>dpv-CivicEngagement</skos:notation>
        <skos:definition xml:lang="en">A context in which individuals participate in the civic life of their community, for example through initiatives, petitions or signature collections.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Context"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN24)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-CivicEngagement</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ClassificationOfIndividuals -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ClassificationOfIndividuals">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Classification Of Individuals</skos:prefLabel>
        <skos:notation>dpv-ClassificationOfIndividuals</skos:notation>
        <skos:definition xml:lang="en">Processing that evaluates, ranks, or categorises natural persons, often based on behavioural, demographic, or personal data.</skos:definition>
        <skos:scopeNote xml:lang="en">Phrasing follows Article 29 Data Protection Working Party and EDPB guidelines.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT, HU, PL (conditions C48)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ClassificationOfIndividuals</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CulturalPrograms -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CulturalPrograms">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Cultural Programs</skos:prefLabel>
        <skos:notation>dpv-CulturalPrograms</skos:notation>
        <skos:definition xml:lang="en">A processing context in which personal data is processed for the running of a cultural programme associated with an event.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30, CN31)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-CulturalProgram</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-CulturalPrograms; the previous index named this term dpv-CulturalProgram. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DataRetention72Hours -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DataRetention72Hours">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Data Retention 72 Hours</skos:prefLabel>
        <skos:notation>dpv-DataRetention72Hours</skos:notation>
        <skos:definition xml:lang="en">A storage condition requiring recorded personal data to be deleted by the controller after 72 hours at the latest, unless a longer period is expressly stipulated in law, an official legal act, a works agreement or with the consent of the personnel representation.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#StorageCondition"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN16)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DataRetention72Hours</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DataStorage -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DataStorage">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Data Storage</skos:prefLabel>
        <skos:notation>dpv-DataStorage</skos:notation>
        <skos:definition xml:lang="en">The storage of data, such as recorded image or acoustic data, as part of a processing operation.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN19)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DataStorage</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV 2.3 has tech:DataStorage; check whether it can be reused instead.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DemocraticProcesses -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DemocraticProcesses">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Democratic Processes</skos:prefLabel>
        <skos:notation>dpv-DemocraticProcesses</skos:notation>
        <skos:definition xml:lang="en">A context in which processing supports the functioning of democratic processes.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Context"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#DemocraticProcessSector"/>
        <skos:related rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-DemocraticProcessInfluencing"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN24)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DemocraticProcesses</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-EmploymentRelationship -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-EmploymentRelationship">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Employment Relationship</skos:prefLabel>
        <skos:notation>dpv-EmploymentRelationship</skos:notation>
        <skos:definition xml:lang="en">An indication that the entity carrying out the processing stands in an employment relationship.</skos:definition>
        <skos:scopeNote xml:lang="en">Intended as a value for dpv:hasRelationWithDataSubject; the parent recorded in the analysis (dpv:Entity) may require revision.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN37)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-EmploymentRelationship</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-FeeManagement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-FeeManagement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Fee Management</skos:prefLabel>
        <skos:notation>dpv-FeeManagement</skos:notation>
        <skos:definition xml:lang="en">The administration of fees payable to a body, including their calculation, collection and recording.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#FeeRequirement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-FeeManagement</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-FundingFees -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-FundingFees">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Funding Fees</skos:prefLabel>
        <skos:notation>dpv-FundingFees</skos:notation>
        <skos:definition xml:lang="en">Records of the fees paid by members or sponsors towards the funding of a body.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-FundingFees</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-IndirectIdentification -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-IndirectIdentification">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Indirect Identification</skos:prefLabel>
        <skos:notation>dpv-IndirectIdentification</skos:notation>
        <skos:definition xml:lang="en">The identification of a natural person by reference to objects or other information that can be linked to that person, rather than directly.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-IndirectIdentification</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-law-IndividualLegalPracticeActivity -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-law-IndividualLegalPracticeActivity">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Individual Legal Practice Activity</skos:prefLabel>
        <skos:notation>sector-law-IndividualLegalPracticeActivity</skos:notation>
        <skos:definition xml:lang="en">A processing context in which a lawyer carries out activities in the course of their individual professional practice.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN46)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-law-IndividualLegalPracticeActivity</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Inspection -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Inspection">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Inspection</skos:prefLabel>
        <skos:notation>dpv-Inspection</skos:notation>
        <skos:definition xml:lang="en">A processing context where personal data is used as part of an evaluative or investigative activity or purpose.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Not recorded</skos:note>
        <skos:note xml:lang="en">Source: Source not recorded in the previous index.</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Inspection</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-LessThan250Employees -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-LessThan250Employees">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Less Than 250 Employees</skos:prefLabel>
        <skos:notation>dpv-LessThan250Employees</skos:notation>
        <skos:definition xml:lang="en">A scale indicating that the organisation carrying out the processing employs fewer than 250 people.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Scale"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN39, CN40)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-LessThan250Employees</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Link -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Link">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Link</skos:prefLabel>
        <skos:notation>dpv-Link</skos:notation>
        <skos:definition xml:lang="en">The linking or interconnection of personal data with other data or systems.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN36, CN37, CN38)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Link</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Overlaps with hapt:dpv-LinkingPersonalData; check whether the two should be merged.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-MembershipLists -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-MembershipLists">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Membership Lists</skos:prefLabel>
        <skos:notation>dpv-MembershipLists</skos:notation>
        <skos:definition xml:lang="en">Lists maintained by a body under public or private law recording those who hold membership of it.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-MembershipLists</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-MonitoringIndividuals -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-MonitoringIndividuals">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Monitoring Individuals</skos:prefLabel>
        <skos:notation>dpv-MonitoringIndividuals</skos:notation>
        <skos:definition xml:lang="en">Processing that involves the supervision or monitoring of individuals, for example at the workplace or of specially protected data subjects.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, NL (conditions C57)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-MonitoringIndividuals</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Overlaps with dpv:SystematicMonitoring and hapt:dpv-Monitoring.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-MoreThan250Employees -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-MoreThan250Employees">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">More Than 250 Employees</skos:prefLabel>
        <skos:notation>dpv-MoreThan250Employees</skos:notation>
        <skos:definition xml:lang="en">A scale indicating that the organisation carrying out the processing employs 250 or more people.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Scale"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN40)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-MoreThan250Employees</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-NonDataSubjectDataSource -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-NonDataSubjectDataSource">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Non Data Subject Data Source</skos:prefLabel>
        <skos:notation>dpv-NonDataSubjectDataSource</skos:notation>
        <skos:definition xml:lang="en">Personal data obtained from a third party or another source rather than directly from the individual concerned, especially in cases where informing the data subject would be difficult or impossible, such as in law enforcement, research, or archival processing.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT, CZ, DE, GR, IS, LV, LT, PT, SK, ES (conditions C28, C71)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-NonDataSubjectDataSource</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-gdpr-NonSystematic -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-gdpr-NonSystematic">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Non-Systematic</skos:prefLabel>
        <skos:notation>eu-gdpr-NonSystematic</skos:notation>
        <skos:definition xml:lang="en">Indication that processing does not meet the definition of systematic.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#eu-gdpr-Systematicity"/>
        <skos:note xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: DPIA Required lists of all Member States</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-NonSystematic</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-NotEmploymentRelationship -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-NotEmploymentRelationship">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Not Employment Relationship</skos:prefLabel>
        <skos:notation>dpv-NotEmploymentRelationship</skos:notation>
        <skos:definition xml:lang="en">An indication that the entity carrying out the processing does not stand in an employment relationship, for example a self-employed practitioner.</skos:definition>
        <skos:scopeNote xml:lang="en">Intended as a value for dpv:hasRelationWithDataSubject; the parent recorded in the analysis (dpv:Entity) may require revision.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN37)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-NotEmploymentRelationship</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataCorrecting -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataCorrecting">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personal Data Correcting</skos:prefLabel>
        <skos:notation>dpv-PersonalDataCorrecting</skos:notation>
        <skos:definition xml:lang="en">The correction or rectification of personal data, for example where the data subject cannot exercise the right to rectification.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BG (conditions C89)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonalDataCorrecting</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataDeletion -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataDeletion">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personal Data Deletion</skos:prefLabel>
        <skos:notation>dpv-PersonalDataDeletion</skos:notation>
        <skos:definition xml:lang="en">The erasure of personal data, for example where the data subject cannot exercise the right to erasure.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BG (conditions C89)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonalDataDeletion</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataRestriction -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonalDataRestriction">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personal Data Restriction</skos:prefLabel>
        <skos:notation>dpv-PersonalDataRestriction</skos:notation>
        <skos:definition xml:lang="en">The restriction of processing of personal data, for example where the data subject cannot exercise the right to restriction of processing.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BG (conditions C89)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonalDataRestriction</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Predict -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Predict">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Predict</skos:prefLabel>
        <skos:notation>dpv-Predict</skos:notation>
        <skos:definition xml:lang="en">To anticipate or forecast aspects of an individual's behaviour, characteristics, or future actions.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Infer"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: EDPB Guidelines on DPIA; Member State DPIA Required lists: BE, HR, CY, DK, FI, FR, DE, GR, HU, IS, IE, IT, LV, LI, LU, NO, PL, PT, RO, SK, ES, SE (conditions C14, C37, C87)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Predict</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PreliminaryExaminationForAwards -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PreliminaryExaminationForAwards">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Preliminary Examination For Awards</skos:prefLabel>
        <skos:notation>dpv-PreliminaryExaminationForAwards</skos:notation>
        <skos:definition xml:lang="en">An examination of candidates or nominees carried out prior to the awarding of a prize, decoration or similar award.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN31, CN32)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PreliminaryExamination</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-PreliminaryExaminationForAwards; the previous index named this term dpv-PreliminaryExamination. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PrivateUse -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PrivateUse">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Private Use</skos:prefLabel>
        <skos:notation>dpv-PrivateUse</skos:notation>
        <skos:definition xml:lang="en">A processing context in which a property or system is used exclusively by the person responsible and other authorised private users.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PrivateUse</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ProfessionalConfidentialityRelationship -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ProfessionalConfidentialityRelationship">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Professional Confidentiality Relationship</skos:prefLabel>
        <skos:notation>dpv-ProfessionalConfidentialityRelationship</skos:notation>
        <skos:definition xml:lang="en">A relationship between a professional and a client in which the professional is bound by an obligation of confidentiality.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ProfessionalConfidentialityRelationship</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PropertyBoundaryLimitation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PropertyBoundaryLimitation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Property Boundary Limitation</skos:prefLabel>
        <skos:notation>dpv-PropertyBoundaryLimitation</skos:notation>
        <skos:definition xml:lang="en">A limitation restricting the spatial recording area of monitoring to the property of the person responsible, save for an unavoidable inclusion of adjacent public traffic areas.</skos:definition>
        <skos:scopeNote xml:lang="en">The parent concept was not stated in the source analysis; the parent shown here is a suggestion for review.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN16)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PropertyBoundaryLimitation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PublicSubsidies -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PublicSubsidies">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Public Subsidies</skos:prefLabel>
        <skos:notation>dpv-PublicSubsidies</skos:notation>
        <skos:definition xml:lang="en">A processing context in which personal data is processed in connection with the award or administration of public subsidies.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN27)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PublicSubsidies</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-RealtimeDataTransmissionWithoutStorage -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-RealtimeDataTransmissionWithoutStorage">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Realtime Data Transmission Without Storage</skos:prefLabel>
        <skos:notation>dpv-RealtimeDataTransmissionWithoutStorage</skos:notation>
        <skos:definition xml:lang="en">Processing in which data, such as image or acoustic data, are transmitted in real time without being recorded or stored.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN19)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-RealtimeDataTransmissionWithoutStorage</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-RealtimeMonitoring -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-RealtimeMonitoring">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Realtime Monitoring</skos:prefLabel>
        <skos:notation>dpv-RealtimeMonitoring</skos:notation>
        <skos:definition xml:lang="en">The transmission and observation of image and acoustic data in real time without any recording being made.</skos:definition>
        <skos:scopeNote xml:lang="en">The parent concept was not stated in the source analysis; the parent shown here is a suggestion for review.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN19)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-RealtimeMonitoring</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Recording -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Recording">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Recording</skos:prefLabel>
        <skos:notation>dpv-Recording</skos:notation>
        <skos:definition xml:lang="en">The recording of data, such as image or acoustic data, so that they can be stored and reproduced.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN19, CN20)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Recording</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ResidentialUse -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ResidentialUse">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Residential Use</skos:prefLabel>
        <skos:notation>dpv-ResidentialUse</skos:notation>
        <skos:definition xml:lang="en">A processing context in which a property is used for residential living by the person responsible and the authorised users of the common household.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ResidentialUse</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-RetentionPeriod -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-RetentionPeriod">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Retention Period</skos:prefLabel>
        <skos:notation>dpv-RetentionPeriod</skos:notation>
        <skos:definition xml:lang="en">The period for which data are kept before they are erased.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#StorageDuration"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN16)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-RetentionPeriod</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-gdpr-Systematic -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-gdpr-Systematic">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Systematic</skos:prefLabel>
        <skos:notation>eu-gdpr-Systematic</skos:notation>
        <skos:definition xml:lang="en">Indication that processing occurs according to a system; is pre-arranged, organised or methodical, and takes place as part of a general plan or is carried out as part of a strategy.</skos:definition>
        <skos:scopeNote xml:lang="en">Definition follows ICO UK. Proposed as subclass of eu-gdpr:Systematicity.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#eu-gdpr-Systematicity"/>
        <skos:note xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: DPIA Required lists of all Member States (conditions C45, C51, C73, C82, C89)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-Systematic</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#eu-gdpr-Systematicity -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#eu-gdpr-Systematicity">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Systematicity</skos:prefLabel>
        <skos:notation>eu-gdpr-Systematicity</skos:notation>
        <skos:definition xml:lang="en">An indication of whether data processing is systematic, i.e. if it is organised and constitutes repeated actions performed according to a plan or method, such as for monitoring, analysis or decision-making.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: BE, BG, CY, FR, GR, HU, IS, NL, NO, PL, SK, SI</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#eu-gdprSystematicity</skos:changeNote>
        <skos:editorialNote xml:lang="en">The previous local name eu-gdprSystematicity did not follow the module-prefix convention and has been normalised to eu-gdpr-Systematicity.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-SystematicMonitoring -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-SystematicMonitoring">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Systematic Monitoring</skos:prefLabel>
        <skos:notation>dpv-SystematicMonitoring</skos:notation>
        <skos:definition xml:lang="en">Processing that involves systematic monitoring of individuals.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN34)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-SystematicMonitoring</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV 2.3 already defines dpv:SystematicMonitoring; check whether it can be reused instead.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ThirdCountryDataTransfer -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ThirdCountryDataTransfer">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Third Country Data Transfer</skos:prefLabel>
        <skos:notation>dpv-ThirdCountryDataTransfer</skos:notation>
        <skos:definition xml:lang="en">The transfer of personal data to a third country or an international organisation.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN36, CN37, CN38, CN51, CN52)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ThirdCountryDataTransfer</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Tracking -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Tracking">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Tracking</skos:prefLabel>
        <skos:notation>dpv-Tracking</skos:notation>
        <skos:definition xml:lang="en">The use of data to follow or track something across contexts.</skos:definition>
        <skos:scopeNote xml:lang="en">While generalised to enable tracking of activities and events, this also encompasses tracking of individuals across websites, apps, devices, and other forms which can constitute systematic monitoring and surveillance.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Use"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: LV, LI</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Tracking</skos:changeNote>
        <skos:editorialNote xml:lang="en">A concept with the same name already exists in DPV 2.3 (dpv:Tracking, pd:Tracking); check whether it can be reused instead.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-UnknownDataSource -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-UnknownDataSource">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Unknown Data Source</skos:prefLabel>
        <skos:notation>dpv-UnknownDataSource</skos:notation>
        <skos:definition xml:lang="en">The origin of personal data cannot be determined or is not known.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSource"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: IE (conditions C94)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-UnknownDataSource</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#ai-UseOfAI -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#ai-UseOfAI">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Use Of AI</skos:prefLabel>
        <skos:notation>ai-UseOfAI</skos:notation>
        <skos:definition xml:lang="en">The use of an AI system in processing of personal data.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Use"/>
        <skos:note xml:lang="en">Proposed for: DPV AI extension (ai)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT, CZ, DK, DE, GR (conditions C32)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#ai-UseOfAI</skos:changeNote>
    </skos:Concept>
    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Entities and Subjects
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://tyttikatariina.github.io/HAPT/#dpv-ApartmentOwner -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-ApartmentOwner">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Apartment Owner</skos:prefLabel>
        <skos:notation>dpv-ApartmentOwner</skos:notation>
        <skos:definition xml:lang="en">The owner of an apartment within a multi-apartment residential building, individually or as part of a community of owners.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN54, CN55, CN63)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-ApartmentOwner</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Association -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Association">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Association</skos:prefLabel>
        <skos:notation>dpv-Association</skos:notation>
        <skos:definition xml:lang="en">A body of persons organised for a common, typically non-profit, purpose, such as an association under public or private law.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#NonProfitOrganisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN10, CN43, CN53)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Association</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">DPV 2.3 has pd:Association, which is a personal data category (membership of an association), not an organisation.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AuthorisedUser -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AuthorisedUser">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Authorised User</skos:prefLabel>
        <skos:notation>dpv-AuthorisedUser</skos:notation>
        <skos:definition xml:lang="en">A person or organisation authorised by the owner to use or dispose of a building, area or locality.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#LegalEntity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN17)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AuthorisedUser</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-AwardGrantingBody -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-AwardGrantingBody">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Award Granting Body</skos:prefLabel>
        <skos:notation>dpv-AwardGrantingBody</skos:notation>
        <skos:definition xml:lang="en">A body responsible for granting prizes, decorations or similar awards and for the preliminary examinations related to them.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN32)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-AwardGrantingBody</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Business -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Business">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Business</skos:prefLabel>
        <skos:notation>dpv-Business</skos:notation>
        <skos:definition xml:lang="en">An organisation carrying out commercial activity.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Business</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-BusinessTrustees -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-BusinessTrustees">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Business Trustees</skos:prefLabel>
        <skos:notation>dpv-BusinessTrustees</skos:notation>
        <skos:definition xml:lang="en">A professional acting as a trustee in respect of the affairs of a business.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-BusinessTrustees</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Candidate -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Candidate">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Candidate</skos:prefLabel>
        <skos:notation>dpv-Candidate</skos:notation>
        <skos:definition xml:lang="en">An individual put forward for consideration in a selection process, such as the awarding of a prize or decoration.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#DataSubject"/>
        <skos:related rdf:resource="https://w3id.org/dpv#JobApplicant"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN32)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Candidate</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CitizensInitiativeOrganiser -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CitizensInitiativeOrganiser">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Citizens Initiative Organiser</skos:prefLabel>
        <skos:notation>dpv-CitizensInitiativeOrganiser</skos:notation>
        <skos:definition xml:lang="en">An organisation or individual that organises a citizens' initiative and processes the personal data of those participating in it.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN24)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-InitiativeOrganisers</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-CitizensInitiativeOrganiser; the previous index named this term dpv-InitiativeOrganisers. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CivilServant -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CivilServant">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Civil Servant</skos:prefLabel>
        <skos:notation>dpv-CivilServant</skos:notation>
        <skos:definition xml:lang="en">A person appointed to the civil service of a state.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-CivilServant</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CommercialCourtClerk -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CommercialCourtClerk">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Commercial Court Clerk</skos:prefLabel>
        <skos:notation>dpv-CommercialCourtClerk</skos:notation>
        <skos:definition xml:lang="en">A clerk of a commercial court who processes personal data for the purposes of performing their official duties.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN46, CN47)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialCourtClerk</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Corporation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Corporation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Corporation</skos:prefLabel>
        <skos:notation>dpv-Corporation</skos:notation>
        <skos:definition xml:lang="en">An organisation incorporated as a legal person distinct from its owners.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Corporation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-CreditAgency -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-CreditAgency">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Credit Agency</skos:prefLabel>
        <skos:notation>dpv-CreditAgency</skos:notation>
        <skos:definition xml:lang="en">An entity that assesses or reports on the creditworthiness of third parties with whom it has no business relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:related rdf:resource="https://w3id.org/dpv/sector/finance#CreditChecking"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-CreditAgency</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DebtCollectionAgency -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DebtCollectionAgency">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Debt Collection Agency</skos:prefLabel>
        <skos:notation>dpv-DebtCollectionAgency</skos:notation>
        <skos:definition xml:lang="en">An entity that carries out debt collection activities in respect of third parties with whom it has no business relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-DebtAgency</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-DebtCollectionAgency; the previous index named this term dpv-DebtAgency. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-health-Dentist -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-health-Dentist">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Dentist</skos:prefLabel>
        <skos:notation>sector-health-Dentist</skos:notation>
        <skos:definition xml:lang="en">A dentist practising individually who processes patient data for patient management and fee billing.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Organisation"/>
        <skos:note xml:lang="en">Proposed for: DPV health sector extension (sector-health)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN21)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-health-Dentist</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Deputies -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Deputies">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Deputies</skos:prefLabel>
        <skos:notation>dpv-Deputies</skos:notation>
        <skos:definition xml:lang="en">A person holding a deputy office or mandate who is paid by a body responsible for the public sector.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Deputies</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-DetectiveAgency -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-DetectiveAgency">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Detective Agency</skos:prefLabel>
        <skos:notation>dpv-DetectiveAgency</skos:notation>
        <skos:definition xml:lang="en">An entity that carries out investigative activities in respect of third parties with whom it has no business relationship.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Entity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN5)</skos:note>
