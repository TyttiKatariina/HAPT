        <skos:notation>dpv-LegalAdvisoryServices</skos:notation>
        <skos:definition xml:lang="en">Providing legal advice to clients within the framework of professional practice.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN22)</skos:note>
