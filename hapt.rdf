        <skos:notation>dpv-HealthInsurance</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with fulfilling obligations in the field of health insurance, such as registering employees and paying contributions.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
