        <skos:note xml:lang="en">Proposed for: DPV health sector extension (sector-health)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN21)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-health-PatientCareBilling</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Payments -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Payments">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Payments</skos:prefLabel>
        <skos:notation>dpv-Payments</skos:notation>
        <skos:definition xml:lang="en">The execution and recording of payment transactions.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/finance#FinancialServiceManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN25)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#sector-finance-Payments</skos:changeNote>
        <skos:editorialNote xml:lang="en">Merged: the condition files use dpv-Payments; the previous index named this term sector-finance-Payments. The condition-file spelling is used for the IRI.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-Payroll -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-Payroll">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Payroll</skos:prefLabel>
        <skos:notation>dpv-Payroll</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with calculating and paying the wages and salaries of employees.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelPayment"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN32)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-Payroll</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Overlaps with hapt:dpv-PayrollManagement and hapt:pd-Payroll.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PayrollManagement -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PayrollManagement">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Payroll Management</skos:prefLabel>
        <skos:notation>dpv-PayrollManagement</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with managing payroll, including the calculation of wages, deductions and contributions.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelPayment"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN62)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PayrollManagement</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Overlaps with hapt:dpv-Payroll.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#sector-law-PersonalCharacteristicsAssessment -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#sector-law-PersonalCharacteristicsAssessment">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personal Characteristics Assessment</skos:prefLabel>
        <skos:notation>sector-law-PersonalCharacteristicsAssessment</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with assessing personality traits and characteristics of natural persons or groups for law enforcement.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv/sector/law#LawEnforcement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#PersonalityTraitAnalysis"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-6-d"/>
        <skos:note xml:lang="en">Proposed for: DPV law sector extension (sector-law)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 6(d) (Recitals 59, 159)</skos:note>
        <skos:note xml:lang="en">Annex III wording: assess personality traits, assess characteristics</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonalCharacteristicsDetermination -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonalCharacteristicsDetermination">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personal Characteristics Determination</skos:prefLabel>
        <skos:notation>dpv-PersonalCharacteristicsDetermination</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with determining the personal characteristics of persons in work-related relationships.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv/ai#PersonalityTraitAnalysis"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-4-b"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 4(b) (Recital 57)</skos:note>
        <skos:note xml:lang="en">Annex III wording: determine characteristics</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonnelBehaviourEvaluation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonnelBehaviourEvaluation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personnel Behaviour Evaluation</skos:prefLabel>
        <skos:notation>dpv-PersonnelBehaviourEvaluation</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with evaluating the behaviour of persons in work-related relationships.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelManagement"/>
        <skos:related rdf:resource="https://w3id.org/dpv#PersonnelBehaviourMonitoring"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-4-b"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, point 4(b) (Recital 57)</skos:note>
        <skos:note xml:lang="en">Annex III wording: evaluate behaviour</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonnelMeasures -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonnelMeasures">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personnel Measures</skos:prefLabel>
        <skos:notation>dpv-PersonnelMeasures</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with measures concerning personnel, such as appointments, transfers and other decisions under service law.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonnelMeasures</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PersonnelTraining -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PersonnelTraining">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Personnel Training</skos:prefLabel>
        <skos:notation>dpv-PersonnelTraining</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with the training of personnel.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN7)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PersonnelTraining</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PoliticalCampaignAdministration -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PoliticalCampaignAdministration">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Political Campaign Administration</skos:prefLabel>
        <skos:notation>dpv-PoliticalCampaignAdministration</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with organising, optimising or structuring political campaigns from an administrative or logistical point of view, using AI systems to whose output natural persons are not directly exposed.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:related rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-8-b"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: Annex III</skos:note>
        <skos:note xml:lang="en">Source: AI Act Annex III, excluded from 8(b) (Recital 61)</skos:note>
        <skos:note xml:lang="en">Annex III wording: tools to organise / optimise / structure political campaigns from an administrative/logistical point of view</skos:note>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtection -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtection">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Preventative Protection</skos:prefLabel>
        <skos:notation>dpv-PreventativeProtection</skos:notation>
        <skos:definition xml:lang="en">Processing carried out to protect persons or property in advance of harm occurring, for example following violations of law that have already occurred or where a special potential hazard exists.</skos:definition>
        <skos:scopeNote xml:lang="en">Relates to hapt:dpv-PreventativeProtectionOfPersons but this could be added to relate to data or property without defining the target of the protection.</skos:scopeNote>
        <skos:broader rdf:resource="https://w3id.org/dpv#Purpose"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PreventativeProtection</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtectionOfPersons -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtectionOfPersons">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Preventative Protection Of Persons</skos:prefLabel>
        <skos:notation>dpv-PreventativeProtectionOfPersons</skos:notation>
        <skos:definition xml:lang="en">Processing carried out for the purpose of preventing harm or protecting individuals before an incident occurs.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#EnforceSecurity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required; DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT (conditions C67); Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PreventativeProtectionOfPersons</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtectionOfProperty -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtectionOfProperty">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Preventative Protection Of Property</skos:prefLabel>
        <skos:notation>dpv-PreventativeProtectionOfProperty</skos:notation>
        <skos:definition xml:lang="en">Processing carried out for the purpose of preventing loss or damage to property before an incident occurs.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#EnforceSecurity"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Required lists: AT (conditions C67)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PreventativeProtectionOfProperty</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtectionOfThings -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtectionOfThings">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Preventative Protection Of Things</skos:prefLabel>
        <skos:notation>dpv-PreventativeProtectionOfThings</skos:notation>
        <skos:definition xml:lang="en">Purposes associated with the preventive protection of things, such as objects or property, against damage or loss.</skos:definition>
        <skos:scopeNote xml:lang="en">Added from the condition files (DPIARequiredConditions.ttl / DPIANotRequiredConditions-2.ttl), where it was written in the impacto: namespace.</skos:scopeNote>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-PreventativeProtection"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN18)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PreventativeProtectionOfThings</skos:changeNote>
        <skos:editorialNote xml:lang="en">Draft definition, not yet reviewed.</skos:editorialNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PrivateEventOrganisation -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PrivateEventOrganisation">
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/HAPT/"/>
        <skos:prefLabel xml:lang="en">Private Event Organisation</skos:prefLabel>
        <skos:notation>dpv-PrivateEventOrganisation</skos:notation>
        <skos:definition xml:lang="en">The organisation of an event by a private entity.</skos:definition>
        <skos:broader rdf:resource="https://tyttikatariina.github.io/HAPT/#dpv-EventManagement"/>
        <skos:note xml:lang="en">Proposed for: DPV core (dpv)</skos:note>
        <skos:note xml:lang="en">Source condition: DPIA Not Required</skos:note>
        <skos:note xml:lang="en">Source: Member State DPIA Not Required lists (CN30, CN31)</skos:note>
        <skos:changeNote xml:lang="en">Previously https://tyttikatariina.github.io/IMPACTO/#dpv-PrivateEventOrganisation</skos:changeNote>
    </skos:Concept>

    <!-- https://tyttikatariina.github.io/HAPT/#dpv-PrivateSectorEvent -->

    <skos:Concept rdf:about="https://tyttikatariina.github.io/HAPT/#dpv-PrivateSectorEvent">
